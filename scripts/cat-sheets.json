{
  "_": "一个视频三只猫。cat-seeds.swift 按它出首尾帧和提示词，cat-frames.swift 按它切片段。每行的 segments 依次首尾相接，end 是这一段结束的秒数；中间的分界点抽帧时会在 ±1 秒内吸附到最像种子图的那一帧。kind: loop 循环 / fidget 小动作 / transition 过渡 / skip 丢弃。",
  "canvas": [1080, 1920],
  "common": "固定机位，静止镜头，无运镜，无缩放。纯绿色背景（#00FF00）始终保持纯色不变，无阴影、无渐变、无地面、无分隔线、无其他物体。三只猫各自待在自己那一行里原地动作，不越界、不互相遮挡、不交流，动作互不同步。保持原有 2D 日系卡通赛璐珞画风、线条和配色不变：橘色虎斑猫，黑色连帽卫衣，身体比例和大小不变，始终完整留在画面内。动作柔和流畅，不出现文字和特效，除动作里提到的东西外不出现新道具。",
  "sheets": [
    {
      "name": "calm",
      "duration": 10,
      "rows": [
        { "from": "sleeping", "to": "sleeping",
          "action": "0-5秒：蜷着熟睡，身体随呼吸缓慢起伏，耳朵轻轻抖一下，头顶的 z 字缓缓上飘；第5秒回到初始姿势。5-10秒：在梦里咂咂嘴，轻轻翻动一下身子又蜷回原样继续睡，第10秒回到初始姿势。",
          "segments": [ { "name": "sleeping", "kind": "loop", "end": 5 }, { "name": "sleeping@turn", "kind": "fidget", "end": 10 } ] },
        { "from": "idle", "to": "idle",
          "action": "0-5秒：双手插在卫衣口袋里站着，轻松呼吸，眨两次眼，尾巴悠闲地摆动；第5秒回到初始姿势。5-10秒：打一个大大的哈欠，伸个懒腰，再把手插回口袋站好，第10秒回到初始姿势。",
          "segments": [ { "name": "idle", "kind": "loop", "end": 5 }, { "name": "idle@yawn", "kind": "fidget", "end": 10 } ] },
        { "from": "awaiting-agent", "to": "awaiting-agent",
          "action": "0-5秒：一只爪子托着腮百无聊赖地等待，手指在脸颊上轻敲两下，慢慢眨一下眼；第5秒回到初始姿势。5-10秒：打个哈欠，眼皮打架差点睡着，又猛地清醒过来继续托腮，第10秒回到初始姿势。",
          "segments": [ { "name": "awaiting-agent", "kind": "loop", "end": 5 }, { "name": "awaiting-agent@doze", "kind": "fidget", "end": 10 } ] }
      ]
    },
    {
      "name": "busy",
      "duration": 10,
      "rows": [
        { "from": "working", "to": "working",
          "action": "0-5秒：在腿上的笔记本电脑上专注快速打字，两只前爪交替敲键盘，中间停顿半秒盯着屏幕再继续；第5秒回到初始姿势。5-10秒：停下打字，用一只爪子挠挠头若有所思，然后恍然大悟地点点头继续打字，第10秒回到初始姿势。",
          "segments": [ { "name": "working", "kind": "loop", "end": 5 }, { "name": "working@think", "kind": "fidget", "end": 10 } ] },
        { "from": "reading", "to": "reading",
          "action": "0-5秒：双手捧书认真阅读，眼睛从左往右扫读，尾巴慢慢摆动；第5秒回到初始姿势。5-10秒：翻一页书，凑近仔细看，点点头继续读，第10秒回到初始姿势。",
          "segments": [ { "name": "reading", "kind": "loop", "end": 5 }, { "name": "reading@page", "kind": "fidget", "end": 10 } ] },
        { "from": "compacting", "to": "compacting",
          "action": "0-5秒：用两只爪子把面前那摞纸竖着磕齐、按平，表情认真有点忙；第5秒回到初始姿势。5-10秒：擦一下额头的汗，长舒一口气，再拍拍那摞纸，第10秒回到初始姿势。",
          "segments": [ { "name": "compacting", "kind": "loop", "end": 5 }, { "name": "compacting@sigh", "kind": "fidget", "end": 10 } ] }
      ]
    },
    {
      "name": "alert",
      "duration": 10,
      "rows": [
        { "from": "waiting", "to": "waiting",
          "action": "0-5秒：举起一只爪子向前方招手，挥两下停顿一下再挥两下，表情着急期待；第5秒回到初始姿势。5-10秒：放下爪子不耐烦地用脚尖点地，左右张望，再重新举起爪子，第10秒回到初始姿势。",
          "segments": [ { "name": "waiting", "kind": "loop", "end": 5 }, { "name": "waiting@tap", "kind": "fidget", "end": 10 } ] },
        { "from": "urgent", "to": "urgent",
          "action": "0-5秒：非常着急，两只爪子用力挥舞，张嘴大喊，旁边的红色警告标志随之闪动；第5秒回到初始姿势。5-10秒：原地蹦起来连跳两下，更大声地喊，第10秒回到初始姿势。",
          "segments": [ { "name": "urgent", "kind": "loop", "end": 5 }, { "name": "urgent@jump", "kind": "fidget", "end": 10 } ] },
        { "from": "finished", "to": "finished",
          "action": "0-5秒：双手高举欢呼，开心地原地蹦一下，眯眼大笑；第5秒回到初始姿势。5-10秒：高举双手左右摇摆跳一小段庆祝舞，第10秒回到初始姿势。",
          "segments": [ { "name": "finished", "kind": "loop", "end": 5 }, { "name": "finished@dance", "kind": "fidget", "end": 10 } ] }
      ]
    },
    {
      "name": "to-working",
      "duration": 5,
      "rows": [
        { "from": "sleeping", "to": "working",
          "action": "0-3秒：醒来揉揉眼睛，坐起来，把笔记本电脑拉到腿上打开；3-5秒：开始打字。",
          "segments": [ { "name": "sleeping_to_working", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "idle", "to": "working",
          "action": "0-3秒：坐下来，把笔记本电脑拉到腿上打开；3-5秒：开始打字。",
          "segments": [ { "name": "idle_to_working", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "waiting", "to": "working",
          "action": "0-3秒：放下招手的爪子，点点头，坐下把电脑拉回腿上；3-5秒：继续打字。",
          "segments": [ { "name": "waiting_to_working", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] }
      ]
    },
    {
      "name": "from-working",
      "duration": 5,
      "rows": [
        { "from": "working", "to": "finished",
          "action": "0-3秒：敲完最后一下键盘，合上电脑放到脚边，站起来双手高举欢呼；3-5秒：保持高举双手开心地笑。",
          "segments": [ { "name": "working_to_finished", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "working", "to": "waiting",
          "action": "0-3秒：停下打字抬起头，放下电脑站起来，举起一只爪子向前方招手；3-5秒：继续轻轻招手。",
          "segments": [ { "name": "working_to_waiting", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "working", "to": "idle",
          "action": "0-3秒：合上电脑放到一边，站起来伸展一下，双手插回口袋；3-5秒：轻松地站着。",
          "segments": [ { "name": "working_to_idle", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] }
      ]
    },
    {
      "name": "settle",
      "duration": 5,
      "rows": [
        { "from": "finished", "to": "idle",
          "action": "0-3秒：放下高举的双手，满意地把手插回卫衣口袋站好；3-5秒：轻松地站着。",
          "segments": [ { "name": "finished_to_idle", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "idle", "to": "sleeping",
          "action": "0-3秒：打个大哈欠，伸个懒腰，慢慢趴下蜷成一团闭上眼；3-5秒：安静地睡着。",
          "segments": [ { "name": "idle_to_sleeping", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "waiting", "to": "urgent",
          "action": "0-3秒：招手越来越着急，两只爪子都挥起来，张嘴大喊，旁边弹出红色警告标志；3-5秒：继续着急地挥手。",
          "segments": [ { "name": "waiting_to_urgent", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] }
      ]
    },
    {
      "name": "to-task",
      "duration": 5,
      "rows": [
        { "from": "working", "to": "reading",
          "action": "0-3秒：把电脑放到一边，拿起一本书打开，凑近认真读；3-5秒：继续读书。",
          "segments": [ { "name": "working_to_reading", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "working", "to": "compacting",
          "action": "0-3秒：把电脑推到一边，从旁边抱来一摞纸开始整理；3-5秒：继续整理纸张。",
          "segments": [ { "name": "working_to_compacting", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "working", "to": "awaiting-agent",
          "action": "0-3秒：敲下回车，把电脑放到一边，用一只爪子托着腮；3-5秒：托腮等待。",
          "segments": [ { "name": "working_to_awaiting-agent", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] }
      ]
    },
    {
      "name": "from-task",
      "duration": 5,
      "rows": [
        { "from": "reading", "to": "working",
          "action": "0-3秒：合上书放到一边，把电脑拉回腿上；3-5秒：继续打字。",
          "segments": [ { "name": "reading_to_working", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "compacting", "to": "working",
          "action": "0-3秒：把整理好的纸推到一边，把电脑拉回腿上；3-5秒：继续打字。",
          "segments": [ { "name": "compacting_to_working", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] },
        { "from": "awaiting-agent", "to": "working",
          "action": "0-3秒：回过神来，放下托腮的爪子，把电脑拉回腿上；3-5秒：继续打字。",
          "segments": [ { "name": "awaiting-agent_to_working", "kind": "transition", "end": 3 }, { "kind": "skip", "end": 5 } ] }
      ]
    }
  ]
}
