#!/usr/bin/env python3
"""hq — task headquarters for Claude Code sessions.

One task card (TASK.md) per piece of work, a ledger of things Claude asked you
(asks.jsonl), and hooks that bind sessions to tasks so the card — not the
session — carries the state. See hq/README.md.

Python 3.9+ standard library only (macOS /usr/bin/python3 works).
"""
import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
import re
import sys
import tempfile
import time

HOME_DIR = os.path.expanduser("~/.claude/hq")
CONFIG = os.path.join(HOME_DIR, "config.json")
STATE = os.path.join(HOME_DIR, "state", "sessions.json")
HQ_BIN = os.path.join(HOME_DIR, "bin", "hq")

STATUSES = ["waiting-on-me", "blocked", "active", "done", "abandoned"]
OPEN_STATUSES = ["waiting-on-me", "blocked", "active"]
RESOLUTIONS = {
    "do": "will do / here is how",
    "drop": "won't do",
    "later": "need to ask someone / revisit later",
    "archive": "no context to answer — parked",
}
DEFAULT_CATEGORIES = ["feature", "bug", "investigation", "review", "ops", "docs", "other"]
# A category is written unquoted into card frontmatter, so keep it to a plain label.
CATEGORY_RE = re.compile(r"^[^\s#\"'\n:,\[\]][^#\"'\n:,\[\]]{0,39}$")
TODO_TIME_RE = re.compile(r"\s*<!--\s*t:([^>]+?)\s*-->\s*$")   # hidden creation time on a todo line
TODO_RE = re.compile(r"^(\s*)- \[([ xX\-])\] (.*)$")
HQ_KINDS = ("hq-asks", "hq-resolved", "hq-update")
# A template placeholder such as `<the next concrete action>` or `@owner <text>`: the protocol's own
# example, echoed back. Never a real value.
PLACEHOLDER_RE = re.compile(r"<[^<>\n]{1,80}>")
UPDATE_KEYS = ("status", "next", "state", "todo", "done", "drop", "log", "ref", "workdir", "touch")
WRITEBACK_MIN_TURN_SECONDS = 120
LOCK_DIR = os.path.join(HOME_DIR, "state", "locks")


# ---------------------------------------------------------------- hq blocks in a reply
def hq_blocks(text):
    """The hq-* fenced blocks of a reply: [{kind, body, start, end, trailing}].

    Read the way Markdown reads fences, line by line — not with one regex over the text, which
    took ```hq-update mentioned mid-sentence, a block quoted inside a ````markdown example, or a
    value holding ``` as a block (or cut a block short). A block counts only at top level, with
    its opening fence at the start of a line and its info string exactly the kind. `trailing`:
    nothing but blank lines and other hq blocks follows it — the end of the reply, where the
    protocol says bookkeeping goes."""
    lines = str(text).split("\n")
    blocks, i, n = [], 0, len(lines)
    while i < n:
        m = re.match(r"^( {0,3})(`{3,}|~{3,})(.*)$", lines[i])
        if not m or (m.group(2)[0] == "`" and "`" in m.group(3)):
            i += 1                      # not a fence (backtick info strings can't hold a backtick)
            continue
        fence, info = m.group(2), m.group(3).strip()
        j = i + 1
        while j < n:
            c = re.match(r"^ {0,3}(`{3,}|~{3,})\s*$", lines[j])
            if c and c.group(1)[0] == fence[0] and len(c.group(1)) >= len(fence):
                break
            j += 1
        if j < n and info in HQ_KINDS and not m.group(1) and fence[0] == "`":
            blocks.append({"kind": info, "body": "\n".join(lines[i + 1:j]), "start": i, "end": j})
        i = j + 1
    covered = {k for b in blocks for k in range(b["start"], b["end"] + 1)}
    for b in blocks:
        b["trailing"] = all(not lines[k].strip() or k in covered for k in range(b["end"] + 1, n))
    return blocks


def strip_hq_blocks(text, kinds=HQ_KINDS):
    """The reply without its hq blocks of these kinds — the gist a person reads."""
    lines = str(text).split("\n")
    drop = {k for b in hq_blocks(text) if b["kind"] in kinds for k in range(b["start"], b["end"] + 1)}
    return "\n".join(l for k, l in enumerate(lines) if k not in drop).strip()


def is_placeholder(value):
    """`<the next concrete action>`, `@owner <text>`, `<short title> <full URL>`: template, not data."""
    return bool(PLACEHOLDER_RE.search(value)) and not re.search(
        r"\w", re.sub(r"@\S+", "", PLACEHOLDER_RE.sub("", value)))


# ---------------------------------------------------------------- card lock
_held = set()


@contextlib.contextmanager
def card_lock(card):
    """Hooks of several sessions and the board all rewrite TASK.md; each read-change-write holds
    this so one writer can't put back an old copy over another's change. Re-entrant within a
    process (apply_update holds it while calling the writers that take it too)."""
    key = os.path.basename(os.path.dirname(os.path.realpath(card))) or "card"
    if key in _held:
        yield
        return
    os.makedirs(LOCK_DIR, exist_ok=True)
    with open(os.path.join(LOCK_DIR, key + ".lock"), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        _held.add(key)
        try:
            yield
        finally:
            _held.discard(key)
            fcntl.flock(f, fcntl.LOCK_UN)


def ok_workdir(path):
    """A directory a task may record as where its work happens: never /, home or the HQ root."""
    return (os.path.isdir(path) and os.path.realpath(path) not in
            ("/", os.path.realpath(hq_root()), os.path.realpath(os.path.expanduser("~"))))


# ---------------------------------------------------------------- utilities
def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def gist(text, n=30):
    """The opening words of an ask — enough to match an answer to its question without
    repeating the whole question back into the session's prompt."""
    t = re.sub(r"\s+", " ", text or "").strip()
    return t if len(t) <= n else t[:n] + "…"


def today():
    return dt.date.today().isoformat()


def die(msg, code=1):
    print(f"hq: {msg}", file=sys.stderr)
    sys.exit(code)


def atomic_write(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".hq-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def hq_root(required=True):
    root = os.environ.get("HQ_ROOT") or load_json(CONFIG, {}).get("root")
    if root:
        root = os.path.expanduser(root)
    if required and (not root or not os.path.isdir(os.path.join(root, "tasks"))):
        die("no HQ configured — run hq/install.sh --root <dir> (or set HQ_ROOT)")
    return root


def tasks_dir():
    return os.path.join(hq_root(), "tasks")


# ---------------------------------------------------------------- task cards
def parse_card(path):
    text = open(path, encoding="utf-8").read()
    meta = {}
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    body = text[m.end():] if m else text
    if m:
        for line in m.group(1).splitlines():
            if ":" not in line or line.lstrip().startswith("#"):
                continue
            k, v = line.split(":", 1)
            v = v.strip()
            if v.startswith('"'):
                v = v[1:v.rfind('"')] if v.count('"') >= 2 else v[1:]
            else:
                v = "" if v.startswith("#") else re.sub(r"\s{2,}#\s.*$", "", v).strip()  # template comments
                if v.startswith("[") and v.endswith("]"):
                    try:
                        v = json.loads(v)
                    except ValueError:
                        pass
            meta[k.strip()] = v
    todos = []
    n = 0                       # every todo line counts, as `hq todo <index>` counts them
    for line in body.splitlines():
        t = TODO_RE.match(line)
        if not t:
            continue
        n += 1
        # A template's placeholder ("- [ ] ...") is not a todo; keep its number, don't list it.
        if t.group(3).strip() in ("...", "…", ""):
            continue
        mark = t.group(2).lower()
        txt = t.group(3).strip()
        created = None
        c = TODO_TIME_RE.search(txt)
        if c:
            created, txt = c.group(1), txt[:c.start()].rstrip()
        owner = None
        o = re.match(r"@(\S+)\s+(.*)$", txt)
        if o:
            owner, txt = o.group(1), o.group(2)
            if owner.casefold() in ("me", "claude"):   # @Claude is Claude's, @Me is yours
                owner = owner.casefold()
        todos.append({"i": n,
                      "state": {"x": "done", "-": "dropped", " ": "open"}[mark],
                      "owner": owner, "text": txt, "created": created})
    meta["todos"] = todos
    meta["grants"] = card_grants(body)
    meta["body"] = body.strip()
    meta["path"] = path
    meta["dir"] = os.path.dirname(path)
    return meta


def card_paths():
    td = tasks_dir()
    out = []
    for d in sorted(os.listdir(td)):
        p = os.path.join(td, d, "TASK.md")
        if os.path.isfile(p):
            out.append(p)
    return out


def find_card(tid):
    tid = tid.upper() if re.match(r"^t-\d+$", tid, re.I) else tid
    for p in card_paths():
        d = os.path.basename(os.path.dirname(p))
        if d == tid or d.startswith(tid + "-"):
            return p
    die(f"no task {tid}")


def set_fields(path, fields):
    with card_lock(path):
        _set_fields(path, fields)


def _set_fields(path, fields):
    text = open(path, encoding="utf-8").read()
    for k, v in fields.items():
        if isinstance(v, list):
            val = json.dumps(v, ensure_ascii=False)
        elif k in ("waiting_on_me", "next", "title"):
            val = '"' + str(v).replace('"', "'") + '"'
        else:
            val = str(v)
        if re.search(rf"^{k}:", text, re.M):
            text = re.sub(rf"^{k}:.*$", lambda _: f"{k}: {val}", text, count=1, flags=re.M)
        else:
            text = text.replace("\n---", f"\n{k}: {val}\n---", 1)
    if "updated" not in fields:
        text = re.sub(r"^updated:.*$", f"updated: {today()}", text, count=1, flags=re.M)
    atomic_write(path, text)


def append_log(path, msg, touch=True):
    with card_lock(path):
        text = open(path, encoding="utf-8").read().rstrip("\n")
        # Local date and time to the second: a task's log often has many entries in one day.
        text += f"\n- {dt.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: {msg}\n"
        atomic_write(path, text)
        if touch:
            set_fields(path, {})


# ---------------------------------------------------------------- categories
def root_config_path():
    return os.path.join(hq_root(), "hq.json")


def load_categories():
    cfg = load_json(root_config_path(), None)
    if not isinstance(cfg, dict) or not isinstance(cfg.get("categories"), list):
        return list(DEFAULT_CATEGORIES)
    return [c for c in cfg["categories"] if isinstance(c, str) and c]


def save_categories(cats):
    cfg = load_json(root_config_path(), {})
    if not isinstance(cfg, dict):
        cfg = {}
    cfg["categories"] = cats
    atomic_write(root_config_path(), json.dumps(cfg, ensure_ascii=False, indent=1) + "\n")


def check_category(name):
    name = (name or "").strip()
    if not CATEGORY_RE.match(name):
        die(f"invalid category {name!r}: 1-40 characters, no # quotes : , [ ]")
    return name


def safe_name(raw, fallback="project"):
    """A folder name made into a valid project/category name: bad characters become '-', at
    most 40 characters."""
    name = re.sub(r"[#\"'\n:,\[\]]+", "-", raw or "").strip(" -")[:40].rstrip(" -")
    return name if CATEGORY_RE.match(name) else fallback


def ensure_listed(name):
    """A category used on a card joins the list, so the board can offer it."""
    if name and name not in load_categories():
        save_categories(load_categories() + [name])
        print(f"hq: added category {name!r}", file=sys.stderr)


def recategorize(old, new):
    """Rewrite every card (open or closed) whose category is `old`. Returns how many."""
    n = 0
    for p in card_paths():
        meta = parse_card(p)
        if (meta.get("category") or "") == old:
            set_fields(p, {"category": new, "updated": meta.get("updated", today())})
            append_log(p, f"category {old!r} → {new or '(none)'!r} (category list changed)", touch=False)
            n += 1
    return n


def category_usage():
    usage = {}
    for p in card_paths():
        c = parse_card(p).get("category") or ""
        usage[c] = usage.get(c, 0) + 1
    return usage


# ---------------------------------------------------------------- projects
# A project groups tasks: { "name": ..., "paths": [dirs] } in hq.json. A task's directory decides
# its project automatically (deepest matching path wins); the card's `project` field can be changed.
def load_projects():
    cfg = load_json(root_config_path(), None)
    out = []
    for pr in (cfg.get("projects") if isinstance(cfg, dict) else None) or []:
        if isinstance(pr, dict) and isinstance(pr.get("name"), str) and pr["name"]:
            out.append({"name": pr["name"],
                        "paths": [x for x in pr.get("paths", []) if isinstance(x, str) and x]})
    return out


def save_projects(projects):
    cfg = load_json(root_config_path(), {})
    if not isinstance(cfg, dict):
        cfg = {}
    cfg["projects"] = projects
    atomic_write(root_config_path(), json.dumps(cfg, ensure_ascii=False, indent=1) + "\n")


def norm_path(x):
    return os.path.realpath(os.path.expanduser(x))


def project_for_path(path):
    if not path:
        return ""
    target = norm_path(path)
    best, depth = "", -1
    for pr in load_projects():
        for root in pr["paths"]:
            r = norm_path(root)
            if (target == r or target.startswith(r + os.sep)) and len(r) > depth:
                best, depth = pr["name"], len(r)
    return best


def project_for_dirs(dirs):
    for d in dirs or []:
        name = project_for_path(d)
        if name:
            return name
    return ""


def ensure_project(name):
    if name and name not in [x["name"] for x in load_projects()]:
        save_projects(load_projects() + [{"name": name, "paths": []}])
        print(f"hq: added project {name!r}", file=sys.stderr)


def relabel(field, old, new, why):
    """Rewrite `field` on every card (open or closed) where it equals `old`. Returns how many."""
    n = 0
    for p in card_paths():
        meta = parse_card(p)
        if (meta.get(field) or "") == old:
            set_fields(p, {field: new, "updated": meta.get("updated", today())})
            append_log(p, f"{field} {old!r} → {new or '(none)'!r} ({why})", touch=False)
            n += 1
    return n


def cmd_project(args):
    projects = load_projects()
    names = [x["name"] for x in projects]
    usage = {}
    for p in card_paths():
        name = parse_card(p).get("project") or ""
        usage[name] = usage.get(name, 0) + 1
    a = args.action
    if a == "list":
        rows = [dict(pr, count=usage.get(pr["name"], 0), listed=True) for pr in projects]
        rows += [{"name": n, "paths": [], "count": c, "listed": False} for n, c in usage.items() if n and n not in names]
        if args.json:
            print(json.dumps(rows, ensure_ascii=False, indent=1))
            return
        for r in rows:
            print(f"{r['name']:<22} {r['count']:>3} task(s)  {', '.join(r['paths']) or '-'}"
                  + ("" if r["listed"] else "   (not in list — used on cards)"))
        if usage.get(""):
            print(f"{'(no project)':<22} {usage['']:>3} task(s)")
        return
    if a == "order":
        # Projects named here go first, in this order; any others keep their place after them.
        wanted = [n for n in args.names if n in names]
        if not wanted:
            die("usage: hq project order NAME NAME ...")
        rest = [pr for pr in projects if pr["name"] not in wanted]
        by_name = {pr["name"]: pr for pr in projects}
        save_projects([by_name[n] for n in wanted] + rest)
        return
    if a == "auto":
        n = 0
        for p in card_paths():
            meta = parse_card(p)
            if meta.get("project"):
                continue
            name = project_for_dirs(meta.get("workdirs") if isinstance(meta.get("workdirs"), list) else [])
            if name:
                set_fields(p, {"project": name, "updated": meta.get("updated", today())})
                n += 1
        print(f"assigned {n} task(s)")
        return
    if not args.names:
        die(f"usage: hq project {a} NAME ...")
    name = check_category(args.names[0])
    if a == "add":
        if name in names:
            die(f"project {name!r} already exists")
        save_projects(projects + [{"name": name, "paths": [os.path.abspath(os.path.expanduser(x)) for x in args.path or []]}])
    elif a == "paths":
        if name not in names:
            die(f"no project {name!r}")
        new_paths = [os.path.abspath(os.path.expanduser(x)) for x in args.names[1:]]
        save_projects([dict(pr, paths=new_paths) if pr["name"] == name else pr for pr in projects])
    elif a == "rename":
        if len(args.names) < 2:
            die("usage: hq project rename OLD NEW")
        new = check_category(args.names[1])
        if new in names and new != name:
            die(f"{new!r} already exists — to merge, use: hq project remove {name!r} --to {new!r}")
        if name not in names and not usage.get(name):
            die(f"no project {name!r}")
        if name in names:
            save_projects([dict(pr, name=new) if pr["name"] == name else pr for pr in projects])
        else:
            save_projects(projects + [{"name": new, "paths": []}])
        print(f"renamed {name!r} → {new!r} ({relabel('project', name, new, 'project renamed')} task(s) updated)")
    elif a == "remove":
        n_used = usage.get(name, 0)
        if n_used and args.to is None:
            print(f"hq: {n_used} task(s) are in {name!r}. Re-run with --to <project> to move them, "
                  f"or --to '' to leave them without a project.", file=sys.stderr)
            sys.exit(3)
        to = ""
        if args.to:
            to = check_category(args.to)
            if to == name:
                die("--to must be a different project")
            ensure_project(to)
        save_projects([pr for pr in load_projects() if pr["name"] != name])
        n = relabel("project", name, to, "project removed") if n_used else 0
        print(f"removed {name!r}" + (f" ({n} task(s) moved to {to or '(none)'!r})" if n else ""))


def cmd_category(args):
    cats = load_categories()
    usage = category_usage()
    if args.action == "list":
        rows = [{"name": c, "count": usage.get(c, 0), "listed": True} for c in cats]
        rows += [{"name": c, "count": n, "listed": False} for c, n in usage.items() if c and c not in cats]
        if args.json:
            print(json.dumps(rows, ensure_ascii=False, indent=1))
            return
        for r in rows:
            print(f"{r['name']:<24} {r['count']:>3} task(s){'' if r['listed'] else '   (not in list — used on cards)'}")
        if usage.get(""):
            print(f"{'(none)':<24} {usage['']:>3} task(s)")
        return
    if not args.names:
        die(f"usage: hq category {args.action} NAME" + (" NEW" if args.action == "rename" else ""))
    name = check_category(args.names[0])
    if args.action == "add":
        if name in cats:
            die(f"category {name!r} already exists")
        save_categories(cats + [name])
    elif args.action == "rename":
        if len(args.names) < 2:
            die("usage: hq category rename OLD NEW")
        new = check_category(args.names[1])
        if new in cats and new != name:
            die(f"{new!r} already exists — to merge, use: hq category remove {name!r} --to {new!r}")
        if name not in cats and not usage.get(name):
            die(f"no category {name!r}")
        save_categories([new if c == name else c for c in cats] if name in cats else cats + [new])
        n = recategorize(name, new)
        print(f"renamed {name!r} → {new!r} ({n} task(s) updated)")
    elif args.action == "remove":
        n_used = usage.get(name, 0)
        if n_used and args.to is None:
            print(f"hq: {n_used} task(s) use {name!r}. Re-run with --to <category> to move them, "
                  f"or --to '' to leave them uncategorized.", file=sys.stderr)
            sys.exit(3)
        to = ""
        if args.to:
            to = check_category(args.to)
            if to == name:
                die("--to must be a different category")
            ensure_listed(to)
        save_categories([c for c in load_categories() if c != name])
        n = recategorize(name, to) if n_used else 0
        print(f"removed {name!r}" + (f" ({n} task(s) moved to {to or '(none)'!r})" if n else ""))


def age_days(meta):
    try:
        return (dt.date.today() - dt.date.fromisoformat(str(meta.get("updated", "")))).days
    except ValueError:
        return None


# ---------------------------------------------------------------- standing grants
# The card's `## Grants` (`## 授权`) section: one plain bullet per kind of thing the user has said
# "yes, and from now on just do it" to. The wording is the rule. A hidden <!--g:TIME ASK-ID-->
# says when, and from which ask (none: added by hand). Plain bullets, never `- [ ]`: every
# checkbox line on a card is a todo. Revoking deletes the line and logs it.
GRANTS_HEADING_RE = re.compile(r"^##[ \t]*(?:Grants|Standing grants|授权|常设授权)[ \t]*$", re.I)
GRANT_LINE_RE = re.compile(r"^[-*][ \t]+(?!\[[ xX\-]\][ \t])(.+?)[ \t]*$")
GRANT_STAMP_RE = re.compile(r"\s*<!--\s*g:([^>]*?)\s*-->\s*$")
GRANT_SUGGEST_RE = re.compile(r"\s*\[(?:grant|授权)[:：]\s*([^\[\]]+?)\s*\]\s*$", re.I)
GRANT_MAX_CHARS = 300
GRANTS_SHOWN = 10              # grants, and characters of grant text, a SessionStart shows
GRANTS_CHARS = 1500


def grants_section(lines):
    """(heading index, end index) of the grants section in a card's lines, or None. Headings
    inside ``` fences don't count: a card may quote an example of the section."""
    head, fence = None, False
    for i, l in enumerate(lines):
        if re.match(r"^\s*(```|~~~)", l):
            fence = not fence
        elif fence:
            continue
        elif head is None and GRANTS_HEADING_RE.match(l):
            head = i
        elif head is not None and l.startswith("## "):
            return head, i
    return (head, len(lines)) if head is not None else None


def card_grants(text):
    lines = text.split("\n")
    sec = grants_section(lines)
    out = []
    if not sec:
        return out
    for j in range(sec[0] + 1, sec[1]):
        m = GRANT_LINE_RE.match(lines[j])
        if not m:
            continue
        txt, at, src = m.group(1), None, None
        st = GRANT_STAMP_RE.search(txt)
        if st:
            txt = txt[:st.start()].rstrip()
            bits = st.group(1).split()
            at = bits[0] if bits else None
            src = bits[1] if len(bits) > 1 else None
        if txt:
            out.append({"i": len(out) + 1, "text": txt, "at": at, "from": src})
    return out


def grant_key(text):
    return " ".join(str(text).split()).casefold()


def clean_grant(text):
    t = " ".join(str(text).replace("<!--", "").replace("-->", "").split())
    t = re.sub(r"^(?:[-*]\s+)?(?:\[[ xX\-]\]\s*)?", "", t)   # a bullet or a checkbox (that'd be a todo)
    if not t or is_placeholder(t):
        die("a grant needs its wording, e.g. 'rerun a verification with the same parameters'")
    if len(t) > GRANT_MAX_CHARS:
        die(f"a grant is one short rule (at most {GRANT_MAX_CHARS} characters)")
    return t


def user_only():
    """Grants come from the user — the board, or hq in their own terminal — never from a session's
    own tool calls. (The board's hq runs without Claude Code's session variables.)"""
    if os.environ.get("CLAUDE_CODE_SESSION_ID"):
        die("a standing grant comes from the user: \"Yes, always\" on the board, or `hq grant add` in "
            "a terminal of their own — never from inside a Claude Code session")


def add_grant(card, text, source=None, at=None, via="cli"):
    """Add a standing grant to the card. Returns it; the same wording already there is not added twice."""
    text = clean_grant(text)
    with card_lock(card):
        lines = open(card, encoding="utf-8").read().split("\n")
        for g in card_grants("\n".join(lines)):
            if grant_key(g["text"]) == grant_key(text):
                return dict(g, existed=True)
        at = at or now_iso()
        item = f"- {text} <!--g:{at}{' ' + source if source else ''}-->"
        sec = grants_section(lines)
        if sec:
            j = sec[1]
            while j > sec[0] + 1 and not lines[j - 1].strip():
                j -= 1
            lines.insert(j, item)
        else:
            # Before the todos (or the status / log section), so it reads as part of the brief.
            head = next((i for i, l in enumerate(lines) if re.match(r"^##\s+(Todo|待办|Log|决策记录)", l, re.I)), None)
            zh = bool(re.search(r"^##\s+(待办|决策记录|当前状态|目标)", "\n".join(lines), re.M))
            block = ["## 授权" if zh else "## Grants", item, ""]
            if head is None:
                lines += [""] + block
            else:
                lines[head:head] = block
        atomic_write(card, "\n".join(lines))
        append_log(card, f"grant added ({via}): {text}")
    return next((dict(g, existed=False) for g in card_grants(open(card, encoding="utf-8").read())
                 if grant_key(g["text"]) == grant_key(text)), {"text": text, "existed": False})


def revoke_grant(card, pick, text=None, via="cli"):
    """Remove grant #pick (or the one with this wording). Returns it, with what restoring it needs."""
    with card_lock(card):
        lines = open(card, encoding="utf-8").read().split("\n")
        sec = grants_section(lines)
        rows = []                       # (line index, grant), numbered as card_grants numbers them
        for j in range(sec[0] + 1, sec[1]) if sec else ():
            g = card_grants("\n".join([lines[sec[0]], lines[j]]))
            if g:
                rows.append((j, g[0]))
        hit = None
        if pick:
            n = int(pick) if str(pick).isdigit() else None
            hit = rows[n - 1] if n and 0 < n <= len(rows) else None
            # The board passes the text it showed: if the numbering moved, go by the text.
            if hit and text and grant_key(hit[1]["text"]) != grant_key(text):
                hit = None
        if not hit and (text or (pick and not str(pick).isdigit())):
            want = grant_key(text or pick)
            hit = next((r for r in rows if grant_key(r[1]["text"]) == want), None)
        if not hit:
            die(f"no grant {text or pick!r} on {os.path.basename(os.path.dirname(card))}")
        del lines[hit[0]]
        sec = grants_section(lines)
        if not any(l.strip() for l in lines[sec[0] + 1:sec[1]]):
            del lines[sec[0]:sec[1]]          # the last one went: so does the empty section
        atomic_write(card, "\n".join(lines))
        append_log(card, f"grant revoked ({via}): {hit[1]['text']}")
    return hit[1]


def grants_for(meta):
    """The grants in force for a task's sessions. (Project-level grants join here with T-079.)"""
    return meta.get("grants") or []


def grants_text(meta):
    gs = grants_for(meta)
    if not gs:
        return ""
    shown, used = [], 0
    for g in gs:
        if len(shown) >= GRANTS_SHOWN or (shown and used + len(g["text"]) > GRANTS_CHARS):
            break
        shown.append(g)
        used += len(g["text"])
    lines = [f"Standing grants on {meta['id']} — permissions the user gave for good, not requests to do "
             f"anything now. While bound to {meta['id']}, a step you'd otherwise ask about that one of these "
             "clearly covers: take it without an hq-asks and name the grant in your reply. Read each one "
             "narrowly; anything bigger, riskier or different: ask as usual."]
    lines += [f"- {g['text']}" for g in shown]
    if len(shown) < len(gs):
        lines.append(f"- … {len(gs) - len(shown)} more in the card's grants section")
    return "\n".join(lines)


def grants_change_text(meta, seen, seen_task=None, full=False, skip=()):
    """What the session needs to hear about grants. `seen`: what it was last told (None: nothing),
    on task `seen_task`. full (SessionStart, a bind): the whole list, after what was revoked since it
    last saw them — a resumed conversation still holds the old list. Otherwise only the changes,
    leaving out `skip` (grants it hears about with the answer that made them)."""
    out = []
    if seen_task and seen_task != meta["id"]:
        if seen:
            out.append(f"The standing grants of {seen_task} don't apply to {meta['id']}: ask before doing those things here.")
        seen = None
    now = [g["text"] for g in grants_for(meta)]
    have = {grant_key(x) for x in seen or []}
    cur = {grant_key(x) for x in now}
    gone = [x for x in seen or [] if grant_key(x) not in cur]
    if full or seen is None:
        if gone:
            out.append(f"Revoked on {meta['id']} since you last saw them — ask again before doing these:")
            out += [f"- {x}" for x in gone]
        t = grants_text(meta)
        if t:
            out.append(t)
        return "\n".join(out)
    skip = {grant_key(x) for x in skip if x}
    added = [x for x in now if grant_key(x) not in have and grant_key(x) not in skip]
    if not added and not gone:
        return "\n".join(out)
    out.append(f"Standing grants on {meta['id']} changed since your last turn:")
    out += [f"+ granted — a permission from now on, not a request to act now: {x}" for x in added]
    out += [f"- revoked — ask again before doing this: {x}" for x in gone]
    return "\n".join(out)


def cmd_grant(args):
    card = find_card(args.task)
    if args.action == "list":
        gs = parse_card(card)["grants"]
        if args.json:
            print(json.dumps(gs, ensure_ascii=False, indent=1))
        for g in [] if args.json else gs:
            print(f"{g['i']:>2}. {g['text']}" + (f"  (from {g['from']})" if g.get("from") else ""))
    elif args.action == "add":
        user_only()
        # The board passes the wording as --text, so wording that starts with "-" is never an option.
        g = add_grant(card, args.text or " ".join(args.rest), source=args.source, at=args.at, via=args.via)
        print(json.dumps(g, ensure_ascii=False))
    elif args.action == "revoke":
        if not args.rest and not args.text:
            die("usage: hq grant revoke <task> <n | wording> [--text <wording as last seen>]")
        g = revoke_grant(card, " ".join(args.rest), text=args.text, via=args.via)
        print(json.dumps(g, ensure_ascii=False))


# ---------------------------------------------------------------- asks ledger
def asks_path(task_dir):
    return os.path.join(task_dir, "asks.jsonl")


def read_asks(task_dir):
    """Fold the event log into current ask records, in creation order."""
    asks = {}
    p = asks_path(task_dir)
    if not os.path.exists(p):
        return []
    for line in open(p, encoding="utf-8"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "open":
            asks[e["id"]] = dict(e, state="open")
        elif e.get("type") == "resolve" and e.get("id") in asks:
            a = asks[e["id"]]
            # An answer is news again: whatever was delivered before it (a "Later" typed into the
            # session) is not this answer. The board and the hook mark delivery after resolving.
            a.update(state=e["resolution"], note=e.get("note", ""), via=e.get("via"),
                     resolved_at=e.get("ts"), seq=e.get("seq"), delivered=None, granted=e.get("granted"))
        elif e.get("type") == "reopen" and e.get("id") in asks:
            asks[e["id"]].update(state="open", note="", via=None, resolved_at=None, delivered=None, snoozed_until=None,
                                 granted=None)
        elif e.get("type") == "snooze" and e.get("id") in asks:
            # "Later" on the board: the ask stays open, out of sight until `until` (local ISO).
            asks[e["id"]]["snoozed_until"] = e.get("until") or None
        elif e.get("type") in ("delivered", "undelivered") and e.get("id") in asks:
            # Which session has been told the answer. Kept on the ask, not on the session, so it
            # survives that session being unbound — a second session must not be told again.
            asks[e["id"]]["delivered"] = e.get("session") if e["type"] == "delivered" else None
    return list(asks.values())


def append_event(task_dir, event):
    event.setdefault("ts", now_iso())
    event.setdefault("seq", time.time_ns())
    with open(asks_path(task_dir), "a", encoding="utf-8") as f:
        f.write(json.dumps(event, ensure_ascii=False) + "\n")


def add_ask(card, text, session=None, context=None):
    meta = parse_card(card)
    existing = read_asks(meta["dir"])
    # "… [grant: <wording>]": the session's suggestion for a standing grant, should the user say
    # "yes, always". Kept apart from the question.
    suggest = None
    m = GRANT_SUGGEST_RE.search(text)
    if m and text[:m.start()].strip():
        suggest, text = " ".join(m.group(1).split())[:GRANT_MAX_CHARS], text[:m.start()]
    # Sessions are reminded of their open asks every turn and tend to repeat them: the same
    # question still open on this task is the same ask, not a new one.
    key = " ".join(text.split()).casefold()
    for a in existing:
        if a.get("state") == "open" and " ".join(a.get("text", "").split()).casefold() == key:
            return a["id"]
    n = max([int(a["id"].rsplit(".", 1)[1]) for a in existing] or [0]) + 1
    aid = f"{meta['id']}.{n}"
    event = {"type": "open", "id": aid, "task": meta["id"], "text": text.strip(), "session": session}
    if suggest:
        event["grant"] = suggest
    if context:
        # The reply that asked — so the board can show why, even after the session is gone.
        event["context"] = strip_hq_blocks(context)[:6000]
    append_event(meta["dir"], event)
    return aid


def find_ask(aid):
    tid = aid.rsplit(".", 1)[0]
    card = find_card(tid)
    for a in read_asks(os.path.dirname(card)):
        if a["id"] == aid:
            return card, a
    die(f"no ask {aid}")


def resolve_ask(aid, resolution, note="", via="cli", grant=None):
    """Answer an ask. With `grant` (only with do): "yes, and from now on just do this kind of
    thing" — the grant goes on the card first, then the answer, which records its wording."""
    if resolution not in RESOLUTIONS:
        die(f"resolution must be one of {', '.join(RESOLUTIONS)}")
    card, _ = find_ask(aid)
    event = {"type": "resolve", "id": aid, "resolution": resolution, "note": note, "via": via}
    if grant and grant.strip():
        if resolution != "do":
            die("a grant goes with a yes (do)")
        user_only()
        g = add_grant(card, grant, source=aid, via=via)
        event["granted"] = g["text"]
    append_event(os.path.dirname(card), event)
    if event.get("granted"):
        # For the board's Undo: a grant that was already there stays when the answer is taken back.
        print(json.dumps({"id": aid, "granted": g["text"], "existed": bool(g.get("existed"))}, ensure_ascii=False))


# ---------------------------------------------------------------- session state
def load_state():
    return load_json(STATE, {})


def save_state(state):
    atomic_write(STATE, json.dumps(state, ensure_ascii=False, indent=1))


@contextlib.contextmanager
def state_lock():
    """Every session's hooks and the board write sessions.json; each read-change-write holds
    this lock so one writer can't put back an old copy over another's change."""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def update_session(sid, change):
    """Apply change(entry) to this session's entry as it is now on disk (skipped if unbound)."""
    with state_lock():
        state = load_state()
        if sid in state:
            change(state[sid])
            save_state(state)


def bound_task(session):
    s = load_state().get(session or "")
    return s.get("task") if s else None


def session_id(arg=None):
    return arg or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""


# ---------------------------------------------------------------- protocol text
def protocol(meta):
    return f"""This Claude Code session is bound to HQ task {meta['id']}: {meta.get('title','')}.
Task card: {meta['path']}
The card, not this conversation, is the source of truth. Rules:
1. Read the card before acting. Keep it current by ending your reply with an hq-update block;
   the Stop hook writes it to the card. Don't run `hq log/set/ref/addtodo/todo` or edit the card
   for this: each tool call is one more round trip over the whole conversation. Write only the
   lines that changed; todo / done / drop / log / ref / workdir may repeat:
```hq-update
status: active | waiting-on-me | blocked | done | abandoned
next: <the next concrete action>
state: <where it stands — replaces the card's status section; one `state:` per line>
todo: @owner <text>
done: <text of an open todo>
drop: <text of an open todo>
log: <a decision and why>
ref: <short title> <full URL>
workdir: <absolute path you started working in>
```
   owner: me = the user, claude, or a person's name. Anything the user has to DO (send, review,
   decide offline) is an `@me` todo; anything you need the user to ANSWER goes in an hq-asks
   block (rule 2). A turn that did work but changed nothing worth recording: a block holding
   just `touch`. The board shows a ref's title, not its URL.
2. When you need the user to decide, confirm or answer something before you can go on, end
   your reply with one self-contained question per line in this block (tracked until answered).
   Something the user has to DO — now, or after something else ("once the PRs merge, send the
   draft to Ping") — is not a question: add it as an `@me` todo on the card instead.
```hq-asks
- <question or request>
```
   If it is a routine, reversible kind of step that will come up again (rerun with the same
   parameters, push review fixes to the same PR …), you may end the line with `[grant: <that
   kind of step, worded as narrowly as the question>]`: the user can then say yes to it for
   good. Never for deleting, sending, spending, merging or force-pushing. Only the user adds
   grants: never add, widen or reword one yourself.
3. When the user answers tracked asks in chat, record each one:
```hq-resolved
- <ask id> <do|drop|later|archive>: <short note>
```
   do = will do / how; drop = won't do; later = needs someone else, revisit; archive = no
   context, parked. Never treat an unanswered ask as declined.
4. If the work drifts into a different task, say so and suggest `/task` for a new card."""


def local_time(text):
    """A time as naive local datetime, from ISO with or without an offset (or a bare date); None
    if it isn't one. `snoozed_until` is kept in this form so Python, the board (JS) and the pet
    (Swift) all read it the same way."""
    try:
        t = dt.datetime.fromisoformat(str(text).replace("Z", "+00:00"))
    except ValueError:
        return None
    return t.astimezone().replace(tzinfo=None) if t.tzinfo else t


def snoozed(a, now=None):
    """An open ask the user put off with "Later", still before the time it comes back."""
    until = local_time(a.get("snoozed_until")) if a.get("snoozed_until") else None
    return bool(until) and until > (now or dt.datetime.now())


def answer_text(state, note, granted=None):
    """How an answer reads to the session: yes / no / the user's own answer, not do / drop."""
    if granted:
        return answer_text(state, note) + f" — and from now on, without asking: {granted} (a standing grant)"
    if state == "do" and note and note.startswith("made an @me todo"):
        return "the user made it an @me todo and will do it themselves — don't ask again" + note[len("made an @me todo"):].replace(" — the user will do it", "", 1)
    if state == "do":
        return f"answer: {note}" if note else "yes — go ahead as you suggested"
    if state == "drop":
        return "no" + (f": {note}" if note else "")
    return state + (f": {note}" if note else "")


def session_alive(sid):
    """True / False from the pet's record of that session, None when there is no record to go by
    (the pet isn't installed, or never saw it)."""
    d = load_json(os.path.join(PET_SESSIONS, f"{sid}.json"), None) if sid else None
    if not isinstance(d, dict):
        return None
    return pid_alive(d.get("pid"))


def owned_elsewhere(a, sid, meta, state):
    """An ask raised by another session that is still on this task: its answer is that
    session's to act on. Several sessions can share a task; each must act only on its own
    answers, or two of them do the same work."""
    asker = a.get("session")
    if not asker or asker == sid:
        return False
    if (state.get(asker) or {}).get("task") != meta["id"]:
        return False          # it left the task — whoever is on it now takes the answer
    alive = session_alive(asker)
    if alive is None:
        # No record of it. With the pet installed that means it ended (the pet drops a dead
        # session's record); without the pet there is no telling, so it keeps its asks.
        return not os.path.isdir(PET_SESSIONS)
    return alive


def open_asks_text(meta, limit=10, sid=None, state=None):
    asks = [a for a in read_asks(meta["dir"]) if a["state"] == "open"]
    if not asks:
        return ""
    lines = [f"Open asks on {meta['id']} still waiting for the user ({len(asks)}):"]
    for a in asks[:limit]:
        theirs = sid is not None and owned_elsewhere(a, sid, meta, state or {})
        later = " (the user will answer this later — carry on with what doesn't depend on it)" if snoozed(a) else ""
        lines.append(f"- {a['id']}{' (asked by another session on this task)' if theirs else ''}{later}: {a['text']}")
    if len(asks) > limit:
        lines.append(f"- … {len(asks) - limit} more (`{HQ_BIN} asks {meta['id']}`)")
    return "\n".join(lines)


CLAUDE_TODOS_MAX = 20          # items, and characters of todo text, a SessionStart list shows
CLAUDE_TODOS_CHARS = 2000


def claude_todos_text(meta, source=""):
    """The card's open @claude todos, for a session starting on it (fresh, resumed, cleared or just
    compacted): a session reads the card once, and after a compaction it forgets the list — so
    stale todos ("comment on PR X" after X merged) were never ticked. Each shows its text exactly
    as on the card, since `done:` / `drop:` match by that text. The newest CLAUDE_TODOS_MAX that
    fit in CLAUDE_TODOS_CHARS are shown, in card order; the rest are counted. Not repeated on every
    prompt: that would cost every turn."""
    items = [t for t in meta.get("todos", [])
             if t["state"] == "open" and (t.get("owner") or "").casefold() == "claude"]
    if not items:
        return ""
    shown, used = [], 0
    for t in reversed(items):
        if len(shown) >= CLAUDE_TODOS_MAX or (shown and used + len(t["text"]) > CLAUDE_TODOS_CHARS):
            break
        shown.append(t)
        used += len(t["text"])
    shown.reverse()
    why = " The conversation was just compacted: this list is the card's, not your memory of it." if source == "compact" else ""
    lines = [f"Open @claude todos on {meta['id']} ({len(items)}).{why} Check each against how things stand now "
             "(PR merged? cluster deleted? run finished?). In your next hq-update, tick finished ones with "
             "`done: <text>` and drop obsolete ones with `drop: <text>`, the text copied exactly as below:"]
    lines += [f"- {t['text']}" for t in shown]
    if len(shown) < len(items):
        lines.append(f"- … {len(items) - len(shown)} older ones not shown — see the card's todo section")
    return "\n".join(lines)


# ---------------------------------------------------------------- commands
def stamp_todos(metas):
    """Give every open todo a creation time: its hidden <!--t:…--> stamp if it has one, else the
    first time HQ saw it (kept in HQ's state, so the card itself is not rewritten)."""
    path = os.path.join(HOME_DIR, "state", "todo-seen.json")
    seen = load_json(path, {})
    changed = False
    now = now_iso()
    for m in metas:
        items = [t for t in m["todos"] if t["state"] == "open"]
        if m.get("waiting_on_me"):
            items.append({"text": m["waiting_on_me"], "_legacy": True})
        for t in items:
            key = f"{m.get('id')}|{t['text']}"
            if not t.get("created"):
                if key not in seen:
                    seen[key] = now
                    changed = True
                if t.get("_legacy"):
                    m["waiting_since"] = seen[key]
                else:
                    t["created"] = seen[key]
    if changed:
        atomic_write(path, json.dumps(seen, ensure_ascii=False))


def cmd_board(args):
    metas = [parse_card(p) for p in card_paths()]
    for m in metas:
        m["age_days"] = age_days(m)
        m["asks"] = read_asks(m["dir"])
    stamp_todos(metas)
    if args.json:
        out = []
        for m in metas:
            d = {k: v for k, v in m.items() if k not in ("dir",)}
            out.append(d)
        cfg = load_json(root_config_path(), {})
        links = cfg.get("links", []) if isinstance(cfg, dict) else []
        print(json.dumps({"root": hq_root(), "focus": focus_state(), "categories": load_categories(), "projects": load_projects(),
                          "links": links, "tasks": out},
                         ensure_ascii=False, indent=1))
        return
    open_asks = [(m, a) for m in metas for a in m["asks"] if a["state"] == "open" and not snoozed(a)]
    my_todos = [(m, t) for m in metas if m.get("status") in OPEN_STATUSES
                for t in m["todos"] if t["state"] == "open" and t["owner"] == "me"]
    my_todos += [(m, {"i": "-", "text": m["waiting_on_me"]}) for m in metas
                 if m.get("status") in OPEN_STATUSES and m.get("waiting_on_me")]
    if open_asks:
        print(f"\n❓ 待你回应 asks ({len(open_asks)})")
        for m, a in open_asks:
            print(f"  {a['id']:<8} {a['text']}")
    if my_todos:
        print(f"\n📝 你的待办 @me ({len(my_todos)})")
        for m, t in my_todos:
            print(f"  {m['id']}#{t['i']:<3} {t['text']}")
    labels = {"waiting-on-me": "🔴 等你处理", "blocked": "🟠 阻塞", "active": "🟢 进行中",
              "done": "✅ 已完成", "abandoned": "⚪ 已放弃"}
    for st in STATUSES:
        if st in ("done", "abandoned") and not args.all:
            continue
        group = sorted([m for m in metas if m.get("status") == st],
                       key=lambda m: str(m.get("updated", "")), reverse=True)
        if not group:
            continue
        print(f"\n{labels[st]} ({len(group)})")
        for m in group:
            age = f"{m['age_days']}d" if m["age_days"] is not None else "?"
            print(f"  {m.get('id','?'):<6} [{m.get('category','?'):<13}] {m.get('title','')}  ({m.get('lead','-')}, {age})")
            mine = [t["text"] for t in m["todos"] if t["state"] == "open" and t["owner"] == "me"]
            if m.get("waiting_on_me"):           # legacy field; @me todos replaced it
                mine.insert(0, m["waiting_on_me"])
            if mine and st not in ("done", "abandoned"):
                print(f"         ⮑ 你: {mine[0]}" + (f"（+{len(mine) - 1}）" if len(mine) > 1 else ""))
            elif m.get("next") and st not in ("done", "abandoned"):
                print(f"         ⮑ 下一步: {m['next']}")
    hidden = sum(1 for m in metas if m.get("status") in ("done", "abandoned"))
    if hidden and not args.all:
        print(f"\n（另有 {hidden} 个已完成/已放弃，用 --all 查看）")


def cmd_show(args):
    card = find_card(args.task)
    print(open(card, encoding="utf-8").read())
    t = open_asks_text(parse_card(card), limit=100)
    if t:
        print(t)


def slugify(s):
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    return s[:40] or "task"


# ---------------------------------------------------------------- focus
# <root>/focus.json: {"focus": ["T-062", "T-003", ...]} — the tasks kept in view, in order.
def focus_path():
    return os.path.join(hq_root(), "focus.json")


def load_focus():
    """The Focus list: the tasks you keep in view, in your order, until you take them off.
    focus.json used to hold one list per day ({"days": {date: [ids]}}); that reads as the most
    recent day's list, and the next save writes the new form ({"focus": [ids]})."""
    f = load_json(focus_path(), {})
    if isinstance(f, dict) and isinstance(f.get("focus"), list):
        return [str(i) for i in f["focus"]]
    days = f.get("days") if isinstance(f, dict) else None
    if not isinstance(days, dict):
        return []
    # The latest day's list, then what the day before it still had (the old board offered to
    # carry those over, so they were meant to stay). Anything not a list of ids is skipped.
    lists = [days[d] for d in sorted(days, reverse=True) if isinstance(days[d], list) and days[d]]
    out = []
    for ids in lists[:2]:
        out += [str(i) for i in ids if isinstance(i, str) and str(i) not in out]
    return out


def save_focus(ids):
    atomic_write(focus_path(), json.dumps({"focus": list(dict.fromkeys(ids))}, ensure_ascii=False, indent=1) + "\n")


def focus_state():
    ids = load_focus()
    status = {}
    for p in card_paths():
        m = parse_card(p)
        status[m.get("id")] = m.get("status")
    # Only open tasks show: one marked done drops out (and comes back if it's reopened); a task
    # that no longer exists is dropped.
    ids = [i for i in ids if status.get(i) in OPEN_STATUSES]
    # "today" / "last_day" / "carry" are kept for older readers; there is no daily list any more.
    return {"ids": ids, "today": today(), "last_day": None, "carry": []}


def focus_add(ids):
    cur = load_focus()
    save_focus(cur + [i for i in ids if i not in cur])


def cmd_focus(args):
    if args.action in ("add", "remove"):
        if not args.tasks:
            die(f"usage: hq focus {args.action} T-012 ...")
        ids = [parse_card(find_card(x))["id"] for x in args.tasks]
        if args.action == "add":
            focus_add(ids)
        else:
            save_focus([i for i in load_focus() if i not in ids])
    elif args.action == "order":
        # Focus in the given order (the board's drag); anything not named keeps its place after.
        ids = list(dict.fromkeys(parse_card(find_card(x))["id"] for x in args.tasks))   # no repeats
        cur = load_focus()
        save_focus([i for i in ids if i in cur] + [i for i in cur if i not in ids])
    elif args.action == "carry":
        pass                        # nothing to carry: Focus no longer resets each day
    st = focus_state()
    if args.json:
        print(json.dumps(st, ensure_ascii=False))
        return
    print(f"Focus: {', '.join(st['ids']) or '— nothing in Focus yet'}")


def cmd_new(args):
    td = tasks_dir()
    nums = [int(m.group(1)) for d in os.listdir(td) for m in [re.match(r"T-(\d+)", d)] if m]
    tid = f"T-{(max(nums) + 1 if nums else 1):03d}"
    d = os.path.join(td, f"{tid}-{slugify(args.slug or args.title)}")
    tpl = os.path.join(hq_root(), "templates", "TASK.md")
    if not os.path.exists(tpl):
        tpl = os.path.join(HOME_DIR, "template", "TASK.md")
    text = open(tpl, encoding="utf-8").read()
    cats = load_categories()
    category = check_category(args.category) if args.category else (
        "other" if "other" in cats else (cats[0] if cats else ""))
    ensure_listed(category)
    workdirs = [os.path.abspath(os.path.expanduser(w)) for w in (args.workdir or [])]
    project = check_category(args.project) if args.project else project_for_dirs(workdirs)
    ensure_project(project)
    os.makedirs(d)
    p = os.path.join(d, "TASK.md")
    atomic_write(p, text)
    set_fields(p, {"id": tid, "title": args.title, "project": project, "category": category,
                   "status": "active", "lead": args.lead or "-", "updated": today(), "workdirs": workdirs})
    if not args.no_focus:
        focus_add([tid])            # a new task joins Focus
    print(tid)
    print(p)


def cmd_bind(args):
    sid = session_id(args.session)
    if not sid:
        die("no session id (run inside Claude Code or pass --session)")
    card = find_card(args.task)
    meta = parse_card(card)
    # Bound from inside the session (its own Bash tool) the session reads this output now;
    # bound from outside (the board) it learns the rules on its next prompt.
    from_inside = sid == os.environ.get("CLAUDE_CODE_SESSION_ID")
    with state_lock():
        state = load_state()
        old = state.get(sid, {})
        prev = old.get("task")
        state[sid] = {"task": meta["id"], "bound_at": now_iso(), "announced": from_inside,
                      "delivered": old.get("delivered", [])}
        # What the session was last told about grants: a re-bound session hears that the old
        # task's grants no longer apply.
        if from_inside:
            state[sid].update(grants=[g["text"] for g in grants_for(meta)], grants_task=meta["id"])
        elif "grants" in old:
            state[sid].update(grants=old["grants"], grants_task=old.get("grants_task") or prev)
        save_state(state)
    fields = {}
    sessions = meta.get("sessions") if isinstance(meta.get("sessions"), list) else []
    if sid[:8] not in sessions:
        fields["sessions"] = sessions + [sid[:8]]
    # The session's directory is where this task's work happens: remember it on the card.
    cwd = os.getcwd() if from_inside else (pet_session(sid) or {}).get("cwd")
    workdirs = meta.get("workdirs") if isinstance(meta.get("workdirs"), list) else []
    if cwd and cwd not in workdirs and ok_workdir(cwd):
        fields["workdirs"] = workdirs + [cwd]
    if not meta.get("project"):
        guess = project_for_path(cwd) or project_for_dirs(workdirs)
        if guess:
            fields["project"] = guess
    if fields:
        set_fields(card, fields)
    if prev and prev != meta["id"]:
        print(f"(re-bound from {prev})")
    print(protocol(meta))
    g = grants_change_text(meta, old.get("grants"), old.get("grants_task") or prev, full=True) if from_inside else ""
    if g:
        print("\n" + g)
    t = open_asks_text(meta)
    if t:
        print("\n" + t)


def cmd_unbind(args):
    sid = session_id(args.session)
    with state_lock():
        state = load_state()
        if state.pop(sid, None) is None:
            print("this session was not bound")
        save_state(state)


def cmd_whoami(args):
    sid = session_id(args.session)
    t = bound_task(sid)
    print(t or "(not bound)")


def cmd_touch(args):
    set_fields(find_card(args.task), {})


def cmd_log(args):
    append_log(find_card(args.task), args.message)


def cmd_set(args):
    fields = {}
    for kv in args.fields:
        if "=" not in kv:
            die(f"expected key=value, got {kv}")
        k, v = kv.split("=", 1)
        if k == "status" and v not in STATUSES:
            die(f"status must be one of {', '.join(STATUSES)}")
        if k == "category" and v:
            v = check_category(v)
            ensure_listed(v)
        if k == "project" and v:
            v = check_category(v)
            ensure_project(v)
        fields[k] = v
    set_fields(find_card(args.task), fields)


def cmd_todo(args):
    card = find_card(args.task)
    with card_lock(card):
        _cmd_todo(args, card)


def _cmd_todo(args, card):
    lines = open(card, encoding="utf-8").read().split("\n")
    todos = card_todos(lines)
    pick = next((x for x in todos if x[1] == args.index), None)
    if args.text is not None:
        # The caller saw this text at #index; the card may have changed since (a session added
        # or removed a todo). Trust the text, not the position.
        want = " ".join(args.text.split())
        if not pick or pick[3] != want:
            pick = next((x for x in todos if x[3] == want), None)
            if not pick:
                die(f"{args.task} no longer has the todo {args.text!r} — refresh and try again")
    if not pick:
        die(f"{args.task} has no todo #{args.index}")
    mark_todo(card, lines, pick, args.state, args.via)


def card_todos(lines):
    """(line index, todo number, match, plain text) for every todo line, numbered as the board does."""
    out, n = [], 0
    for i, line in enumerate(lines):
        t = TODO_RE.match(line)
        if t:
            n += 1
            out.append((i, n, t, todo_plain(t.group(3))))
    return out


def mark_todo(card, lines, pick, state, via):
    with card_lock(card):
        _mark_todo(card, lines, pick, state, via)


def _mark_todo(card, lines, pick, state, via):
    i, num, t, _ = pick
    mark = {"done": "x", "drop": "-", "open": " "}[state]
    lines[i] = f"{t.group(1)}- [{mark}] {t.group(3)}"
    atomic_write(card, "\n".join(lines))
    append_log(card, f"todo #{num} → {state} ({via}): {TODO_TIME_RE.sub('', t.group(3))}")


def todo_plain(raw):
    """A todo line's text as the board shows it: no time stamp, no @owner, spaces collapsed."""
    txt = TODO_TIME_RE.sub("", raw.strip()).rstrip()
    o = re.match(r"@(\S+)\s+(.*)$", txt)
    return " ".join((o.group(2) if o else txt).split())


def cmd_ref(args):
    card = find_card(args.task)
    with card_lock(card):
        _cmd_ref(args, card)


REF_URL_RE = re.compile(r"https?://[\x21\x23-\x26\x28-\x3b\x3d\x3f-\x7e]+")


# Canonical forms of a link: the thing it is about, not the view of it. A PR's /files tab, a Jira
# issue opened from a board, a Jenkins build's console or test report — each is the PR, the issue,
# the build. A link to one comment stays its own: it is evidence someone chose to keep. And any
# other #fragment is kept (#L10, #/runs/2, #Design all point somewhere else).
# board.js has the same patterns (CANON_* there); keep them in step.
URL_SPLIT_RE = re.compile(r"^(https?://)([^/?#]*)(.*)$", re.S | re.I)
GH_ITEM_RE = re.compile(r"^(/[^/?#]+/[^/?#]+/(?:pull|issues)/[0-9]+)(?:[/?#].*)?$", re.S)
GH_COMMENT_RE = re.compile(r"#(?:issuecomment-|discussion_r|pullrequestreview-|r)[0-9]+$")
JIRA_BROWSE_RE = re.compile(r"^(.*?/browse/[A-Z][A-Z0-9]+-[0-9]+)(?:[/?#].*)?$", re.S)
JIRA_PATH_RE = re.compile(r"^(.*?)/jira/[^?#]*/([A-Z][A-Z0-9]+-[0-9]+)(?:[/?#].*)?$", re.S)
JIRA_SELECTED_RE = re.compile(r"^(.*?)/jira/[^?#]*\?(?:[^#]*&)?selectedIssue=([A-Z][A-Z0-9]+-[0-9]+)(?:[&#].*)?$", re.S)
JIRA_COMMENT_RE = re.compile(r"[?&]focusedCommentId=([0-9]+)|#comment-([0-9]+)$")
JENKINS_BUILD_RE = re.compile(r"^((?:/[^/?#]+)*?(?:/job/[^/?#]+)+/[0-9]+)(?:/([^?#]*))?(?:[?#].*)?$", re.S)
# What may follow a build number on a Jenkins host not named "jenkins": its own pages only, so a
# careers site's /job/engineer/12345/apply is left alone.
JENKINS_VIEW_RE = re.compile(r"^(?:|console\w*|testReport\b.*|artifact\b.*|changes|parameters|"
                             r"pipeline\S*|flowGraphTable|execution\b.*|timestamps\b.*|"
                             r"injectedEnvVars|display\b.*|stages\b.*|api\b.*)/?$", re.S)
URL_TAIL = "/).,;:"


def is_jenkins(host, view=""):
    return "jenkins" in host or bool(JENKINS_VIEW_RE.match(view or ""))


def canonical_url(url):
    """The canonical form of one URL. Scheme and host compare in lower case. Then:
    GitHub  …/<o>/<r>/pull/<n> (or issues/<n>) with anything after it → …/<o>/<r>/pull/<n>,
            except a comment (#issuecomment-, #discussion_r, #pullrequestreview-, #r<n>), which
            stays as written;
    Jira    …/browse/KEY-1 with any query or fragment → …/browse/KEY-1, and a …/jira/…/KEY-1
            page (or one with selectedIssue=KEY-1) → …/browse/KEY-1; a comment (focusedCommentId=N or #comment-N) →
            …/browse/KEY-1?focusedCommentId=N;
    Jenkins …/job/<a>[/job/<b>…]/<build#>/<console, testReport, artifact/…> → …/job/<a>…/<build#>
            (a job URL without a build number stays as it is; on a host without "jenkins" in its
            name, only Jenkins' own pages after the build number count);
    anything else is kept whole, #fragment too (an empty `#` and, with no fragment, a trailing `/`
    go). Trailing `/).,;:` never count."""
    url = str(url).rstrip(URL_TAIL)
    m = URL_SPLIT_RE.match(url)
    if not m:
        return url
    host = m.group(2).lower()
    base, rest = m.group(1).lower() + host, m.group(3)
    g = GH_ITEM_RE.match(rest) if "github" in host else None
    if g:
        # A comment keeps its whole URL: a review comment (#r123) opens only on its /files page.
        return base + (rest if GH_COMMENT_RE.search(rest) else g.group(1))
    j = JIRA_BROWSE_RE.match(rest) or JIRA_PATH_RE.match(rest) or JIRA_SELECTED_RE.match(rest)
    if j:
        c = JIRA_COMMENT_RE.search(rest)
        issue = j.group(1) if j.re is JIRA_BROWSE_RE else j.group(1) + "/browse/" + j.group(2)
        return base + issue + (f"?focusedCommentId={c.group(1) or c.group(2)}" if c else "")
    b = JENKINS_BUILD_RE.match(rest)
    if b and is_jenkins(host, b.group(2)):
        return base + b.group(1)
    rest = rest[:-1] if rest.endswith("#") else rest
    return base + (rest if "#" in rest else rest.rstrip("/"))


def ref_key(ref):
    """What makes two refs the same: the thing they point to, not their title — "smoke #9 URL" and
    "smoke #9 (passed) URL" are one ref, and so are a PR and its /files tab. Only a ref with
    exactly one URL is keyed by it: its canonical_url, minus the trailing `/` and the `).,;:` a
    sentence leaves stuck to it (the URL regex is ASCII-only, so full-width `）。，；：` never reach
    the match). A ref without a URL (a ticket key), or with two or more, is its own text with
    whitespace collapsed — so merging can't drop a second link.
    The board keys refs the same way (refKey in board.js); keep the two in step."""
    text = str(ref)
    urls = REF_URL_RE.findall(text)
    if len(urls) == 1:
        return canonical_url(urls[0])
    return " ".join(text.split())


def _lower_host(url):
    m = URL_SPLIT_RE.match(url)
    return m.group(1).lower() + m.group(2).lower() + m.group(3) if m else url


def ref_url_is_canonical(ref):
    """A one-URL ref whose link already is the canonical one (up to the case of its host, and the
    trailing `/).,;:`): its title describes the thing itself, not one view of it."""
    urls = REF_URL_RE.findall(str(ref))
    if len(urls) != 1:
        return False
    u = urls[0].rstrip(URL_TAIL)
    return _lower_host(u) == canonical_url(u)


def with_canonical_url(ref):
    """The ref with its one URL written in canonical form, the title text kept as it is."""
    text = str(ref)
    found = list(REF_URL_RE.finditer(text))
    if len(found) != 1 or ref_url_is_canonical(text):
        return text
    m = found[0]
    u = m.group(0).rstrip(URL_TAIL)
    return text[:m.start()] + canonical_url(u) + text[m.start() + len(u):]


def merge_refs(have, new):
    """`have` with `new` added, one entry per link, at the place the first of them had. An entry
    with no other of its key stays exactly as written. Entries with the same key become one: its
    URL the canonical one, its title that of an entry already linking
    to the canonical URL (it names the thing itself; the newest such one, so a title can move on —
    PR #9 open → merged), else the newest entry's. Duplicates already in `have` collapse the same
    way, and merging the result again changes nothing."""
    order, groups = [], {}
    for r in list(have) + list(new):
        r = str(r).strip()
        if not r:
            continue
        k = ref_key(r)
        if k not in groups:
            groups[k] = []
            order.append(k)
        groups[k].append(r)
    out = []
    for k in order:
        rs = groups[k]
        if len(set(rs)) == 1:      # nothing merged: the link stays exactly as it was written
            out.append(rs[0])
            continue
        exact = [r for r in rs if ref_url_is_canonical(r)]
        out.append(with_canonical_url(exact[-1] if exact else rs[-1]))
    return out


def _cmd_ref(args, card):
    meta = parse_card(card)
    refs = meta.get("refs") if isinstance(meta.get("refs"), list) else []
    if args.action == "add":
        ref = args.ref.strip()
        if not ref or "\n" in ref:
            die("empty ref")
        merged = merge_refs(refs, [ref])
        if merged != refs:
            set_fields(card, {"refs": merged})
    elif args.action == "remove":
        # Removing a link removes every entry pointing at it, so no older duplicate shows up again.
        # What went is printed as JSON — {"removed": [{"i": index, "ref": text}, …]} — and
        # `hq ref restore` takes it back, which is how the board's Undo puts every entry back.
        key = ref_key(args.ref)
        gone = [{"i": i, "ref": r} for i, r in enumerate(refs) if ref_key(r) == key]
        if not gone:
            die(f"{args.task} has no ref {args.ref!r}")
        set_fields(card, {"refs": [r for r in refs if ref_key(r) != key]})
        print(json.dumps({"removed": gone}, ensure_ascii=False))
    else:
        # restore: undo a remove. Each entry goes back at its old index (in order, so the list is
        # as it was if nothing changed meanwhile). A link that is on the card again by now (re-added
        # since, or a second Undo) is left as it is.
        try:
            items = json.loads(args.ref)
            items = items.get("removed", items) if isinstance(items, dict) else items
            items = sorted(((int(x["i"]), str(x["ref"]).strip()) for x in items), key=lambda x: x[0])
        except (ValueError, TypeError, KeyError, AttributeError):
            die("restore takes the JSON `hq ref remove` printed")
        out = [str(r) for r in refs]
        there = {ref_key(r) for r in out}
        for i, r in items:
            if r and "\n" not in r and ref_key(r) not in there:
                out.insert(max(0, min(i, len(out))), r)
        if out != refs:
            set_fields(card, {"refs": out})


def cmd_addtodo(args):
    add_todo(find_card(args.task), args.text)


def add_todo(card, text):
    with card_lock(card):
        _add_todo(card, text)


def _add_todo(card, text):
    lines = open(card, encoding="utf-8").read().split("\n")
    item = f"- [ ] {text.strip()} <!--t:{now_iso()}-->"
    head = next((i for i, l in enumerate(lines) if re.match(r"^##\s+(Todo|待办)", l, re.I)), None)
    last_todo = None
    for i, l in enumerate(lines):
        if TODO_RE.match(l) and (head is None or i > head):
            last_todo = i
    if last_todo is not None:
        lines.insert(last_todo + 1, item)
    elif head is not None:
        j = head + 1
        while j < len(lines) and lines[j].strip().startswith("<!--"):
            j += 1
        lines.insert(j, item)
    else:
        lines += ["", "## Todo", item]
    atomic_write(card, "\n".join(lines))
    set_fields(card, {})


def update_lines(block):
    """The lines of an hq-update block as (key, value), with list markers and blank lines dropped.
    Forgiving where a model writing in Chinese or quoting values would otherwise lose a round
    trip: a full-width colon, any case in the key, and one pair of quotes round the value."""
    out = []
    for raw in block.splitlines():
        line = re.sub(r"^\s*(?:[-*]|\d+[.)])\s+", "", raw).strip()
        if not line:
            continue
        m = re.match(r"^([A-Za-z]+)\s*(?:[:：]\s*(.*))?$", line)
        if not m:
            out.append((None, line))
            continue
        v = (m.group(2) or "").strip()
        for a, b in ('""', "''", "“”", "‘’", "「」", "``"):
            if len(v) >= 2 and v[0] == a and v[-1] == b:
                v = v[1:-1].strip()
                break
        out.append((m.group(1).lower(), v))
    return out


STATUS_HEADING_RE = re.compile(
    r"^##[ \t]*(?:Status|Current state|当前状态|状态)(?:[ \t]*[(（][^\n]*)?[ \t]*\n(.*?)(?=^##\s|\Z)",
    re.M | re.S | re.I)


def todo_owner(raw):
    o = re.match(r"@(\S+)\s", TODO_TIME_RE.sub("", raw.strip()) + " ")
    return o.group(1).casefold() if o else None


def match_todo(todos, kind, want):
    """The todo a `done:` / `drop:` line means: (todo, None) to change, (None, None) when it is
    already settled (a repeat, or ticked on the board meanwhile), (None, problem) otherwise.

    Exact text first, over every todo whatever its state — so a repeated `done: rerun the suite`
    can't fall through to a substring match and tick `rerun the suite on CI` instead. A
    substring is tried only when no todo has that exact text, and only among open ones."""
    owner = todo_owner(want)
    key = " ".join(todo_plain(want).split()).casefold()
    mine = [x for x in todos if owner is None or todo_owner(x[2].group(3)) == owner]
    open_ = [x for x in mine if x[2].group(2) == " "]
    exact = [x for x in mine if x[3].casefold() == key]
    if exact:
        live = [x for x in exact if x[2].group(2) == " "]
        if not live:
            return None, None
        hits = live
    else:
        hits = [x for x in open_ if key and key in x[3].casefold()]
    if len(hits) == 1:
        return hits[0], None
    listing = "; ".join(f"\"{x[3]}\"" for x in (hits or open_)[:8]) or "none"
    return None, (f"`{kind}: {want}` matches {len(hits) or 'no'} open todos — "
                  f"{'candidates' if hits else 'open todos'}: {listing}")


def apply_update(card, block, via="session"):
    """Apply an hq-update block — the card changes a session writes in its reply instead of running
    `hq log/set/ref/addtodo/todo` one tool call at a time. Every such call is another model round trip
    that re-reads the whole conversation; the block costs a few output tokens.

    All or nothing: the whole block is checked first, and if any line can't be applied nothing
    is written and the problems are returned, for the Stop hook to send back. Applying the good
    lines anyway made the natural retry — the whole block again, corrected — add every todo and
    log line twice. Adding is idempotent too (an open todo with the same text or a log line already
    there is skipped), so a block that does arrive twice changes nothing. A `ref:` line whose URL
    is already on the card replaces that entry's title in place — on purpose, so a title can move
    on (PR #9 open → merged) — and repeating it changes nothing.
    A block made only of template placeholders is the protocol's example echoed back: ignored."""
    entries = update_lines(block)
    if entries and all(v and is_placeholder(v) for _, v in entries):
        return []
    with card_lock(card):
        return _apply_update(card, entries, via)


def _apply_update(card, entries, via):
    problems, fields, state = [], {}, []
    adds, marks, logs, refs, dirs = [], [], [], [], []
    text = open(card, encoding="utf-8").read()
    lines = text.split("\n")
    todos = card_todos(lines)
    picked = set()
    for k, v in entries:
        if k not in UPDATE_KEYS:
            problems.append(f"not an hq-update line: {v if k is None else k + ': ' + v}")
        elif k == "touch":
            continue
        elif not v:
            problems.append(f"`{k}:` with nothing after it")
        elif is_placeholder(v):
            problems.append(f"`{k}: {v}` is the template's placeholder, not a value")
        elif k == "status":
            if v.lower() in STATUSES:
                fields["status"] = v.lower()
            else:
                problems.append(f"status must be one of {', '.join(STATUSES)} (got {v!r})")
        elif k == "next":
            fields["next"] = v
        elif k == "state" and v.lstrip().startswith("#"):
            # A heading here would start a section of its own (a forged `## Grants`, say).
            problems.append(f"`state: {v}` — a state line can't be a heading; write it as plain text")
        elif k == "state":
            # A checkbox here would turn into a real todo in the Status section.
            state.append(re.sub(r"^-\s*\[[ xX\-]\]\s*", "", v))
        elif k == "todo":
            adds.append(v)
        elif k in ("done", "drop"):
            pick, problem = match_todo(todos, k, v)
            if problem:
                problems.append(problem)
            elif pick and pick[0] not in picked:
                picked.add(pick[0])
                marks.append((k, pick))
        elif k == "log":
            logs.append(v)
        elif k == "ref":
            refs.append(v)
        elif k == "workdir":
            d = os.path.normpath(os.path.expanduser(v))
            if not os.path.isabs(d) or not os.path.isdir(d):
                problems.append(f"`workdir: {v}` is not an existing absolute path")
            elif not ok_workdir(d):
                problems.append(f"`workdir: {v}` — /, the home folder and the HQ root are never a workdir")
            else:
                dirs.append(d)
    if state and not STATUS_HEADING_RE.search(text):
        problems.append("`state:` — the card has no `## Status` / `## 当前状态` section")
    if problems:
        return problems

    # Ticks first, against the line numbers checked above; adding todos would shift them.
    for k, (i, num, t, _) in marks:
        lines[i] = f"{t.group(1)}- [{'x' if k == 'done' else '-'}] {t.group(3)}"
    if marks:
        atomic_write(card, "\n".join(lines))
        for k, (i, num, t, _) in marks:
            append_log(card, f"todo #{num} → {k} ({via}): {TODO_TIME_RE.sub('', t.group(3))}", touch=False)
    for item in adds:
        have = {(todo_owner(x[2].group(3)), x[3].casefold())
                for x in card_todos(open(card, encoding="utf-8").read().split("\n")) if x[2].group(2) == " "}
        if (todo_owner(item), " ".join(todo_plain(item).split()).casefold()) not in have:
            add_todo(card, item)
    if state:
        text = open(card, encoding="utf-8").read()
        m = STATUS_HEADING_RE.search(text)
        atomic_write(card, text[:m.start(1)] + "\n".join(state) + "\n\n" + text[m.end(1):])
    meta = parse_card(card)
    if refs:
        have = meta.get("refs") if isinstance(meta.get("refs"), list) else []
        merged = merge_refs(have, refs)
        if merged != have:
            fields["refs"] = merged
    if dirs:
        have = meta.get("workdirs") if isinstance(meta.get("workdirs"), list) else []
        known = {os.path.normpath(h) for h in have}
        fields["workdirs"] = have + [d for d in dict.fromkeys(dirs) if d not in known]
    set_fields(card, fields)            # also stamps `updated`, so a `touch` block is a touch
    logged = open(card, encoding="utf-8").read()
    for msg in dict.fromkeys(logs):
        if not re.search(r"^- \d{4}-\d\d-\d\d \d\d:\d\d:\d\d: " + re.escape(msg) + r"\s*$", logged, re.M):
            append_log(card, msg)
    return []

def cmd_ask(args):
    if args.action == "add":
        print(add_ask(find_card(args.target), " ".join(args.rest), session_id(None) or None))
    elif args.action == "delivered":
        # The board typed this answer straight into the session: don't inject it again next turn.
        card, a = find_ask(args.target)
        sid = args.session or a.get("session")
        append_event(os.path.dirname(card), {"type": "undelivered" if args.undo else "delivered",
                                             "id": args.target, "session": sid})
    elif args.action == "snooze":
        # The ask stays open; the board and the pet leave it out until then. --until "" clears it.
        card, _ = find_ask(args.target)
        if args.until is None:
            until = (dt.date.today() + dt.timedelta(days=1)).isoformat() + "T00:00:00"
        elif args.until == "":
            until = ""
        else:
            t = local_time(args.until)
            if t is None:
                die(f"--until must be a date or time like 2026-11-22 or 2026-11-22T09:00, not {args.until!r}")
            until = t.strftime("%Y-%m-%dT%H:%M:%S")
        append_event(os.path.dirname(card), {"type": "snooze", "id": args.target, "until": until, "via": args.via})
    elif args.action == "reopen":
        card, _ = find_ask(args.target)
        append_event(os.path.dirname(card), {"type": "reopen", "id": args.target, "via": args.via})
    elif args.action == "resolve":
        if not args.rest:
            die("usage: hq ask resolve <ask-id> <do|drop|later|archive> [note…]")
        resolve_ask(args.target, args.rest[0], args.note or " ".join(args.rest[1:]), via=args.via, grant=args.grant)


def cmd_asks(args):
    paths = [find_card(args.task)] if args.task else card_paths()
    out = []
    for p in paths:
        m = parse_card(p)
        for a in read_asks(m["dir"]):
            if args.all or a["state"] == "open":
                a["title"] = m.get("title")
                out.append(a)
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return
    for a in out:
        st = "" if a["state"] == "open" else f"  [{a['state']}{': ' + a['note'] if a.get('note') else ''}]"
        if a["state"] == "open" and snoozed(a):
            st = f"  [later — until {a['snoozed_until'][:16].replace('T', ' ')}]"
        print(f"{a['id']:<8} {a['text']}{st}")


# ---------------------------------------------------------------- live sessions
PET_SESSIONS = os.path.expanduser("~/.claude/pet/sessions")


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (TypeError, ValueError):
        return False
    return True


def transcript_tail(path, nbytes=600_000):
    if not path or not os.path.exists(path):
        return []
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - nbytes))
        # Not splitlines(): that also breaks at U+0085, U+2028… inside a JSON string.
        lines = f.read().decode("utf-8", "ignore").split("\n")
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


def message_role(o):
    """Who said a transcript entry: "user", "assistant", or None. A prompt the user typed while
    Claude was busy is not a user entry: it is an attachment of type queued_command, folded into
    the running turn, so it counts as the user's too (only when a human typed it)."""
    t = o.get("type")
    if t == "attachment":
        a = o.get("attachment") or {}
        if a.get("type") == "queued_command" and (a.get("origin") or {}).get("kind") == "human" \
                and a.get("commandMode", "prompt") == "prompt":
            return "user"
        return None
    return t if t in ("user", "assistant") else None


def message_text(o):
    """Visible text of a transcript entry: the user's typed prompt or Claude's prose."""
    if o.get("isSidechain") or o.get("isMeta") or o.get("isCompactSummary"):
        return None  # compaction summaries are not something anyone said
    c = o.get("message", {}).get("content")
    role = message_role(o)
    if role == "user" and o.get("type") == "attachment":
        c = o["attachment"].get("prompt")
    if role == "user":
        if isinstance(c, str):
            t = c
        elif isinstance(c, list):
            if any(isinstance(x, dict) and x.get("type") == "tool_result" for x in c):
                return None
            t = "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
        else:
            return None
        if t.startswith("<") and ("command-" in t[:40] or "local-command" in t[:40]
                                  or "system-reminder" in t[:40] or "task-notification" in t[:40]):
            return None
        return t.strip() or None
    if o.get("type") == "assistant" and isinstance(c, list):
        t = "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
        return t.strip() or None
    return None


def ts_seconds(ts):
    try:
        return dt.datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


# ---------------------------------------------------------------- peek activity
# Peek shows what a session is doing, not just what was said: Claude's tool calls between the
# messages (one line each, paired with their results), its own todo list, and the turn in
# progress. Rows carry a summary only; `hq peek <sid> --tool <id>` gives one call's full input
# and output when a row is opened, so the list the board polls every few seconds stays small.
PEEK_TOOLS_MAX = 300   # tool rows in one Peek window; older ones drop off (messages never do)
PEEK_BYTES_MAX = 64_000_000   # how far back Peek reads for its n messages
TODO_TOOLS = {"TodoWrite", "TaskCreate", "TaskUpdate", "TaskList", "TaskGet"}  # shown as the todo list
NOTE_ID = re.compile(r"<tool-use-id>([^<]+)</tool-use-id>")
NOTE_TASK = re.compile(r"<task-id>([^<]+)</task-id>")   # a background command's or agent's own id
NOTE_STATUS = re.compile(r"<status>([^<]+)</status>")
NOTE_RESULT = re.compile(r"<result>(.*?)(?:</result>|\Z)", re.S)
STOP_TOOLS = {"TaskStop", "KillShell", "KillBash"}   # stop a background command or agent
INTERRUPTED = "[Request interrupted by user"


def background_id(tur):
    """The id a background call goes by once launched: a command's backgroundTaskId, an agent's
    agentId. Task notifications and TaskStop name it, not always the tool_use id."""
    if isinstance(tur, dict) and (tur.get("backgroundTaskId") or tur.get("isAsync")):
        return tur.get("backgroundTaskId") or tur.get("agentId")
    return None


def note_status(st):
    """A task notification's <status> as a row status: finished, stopped on purpose, or failed."""
    st = (st or "").strip()
    return "ok" if st == "completed" else "stopped" if st in ("killed", "stopped", "cancelled") else "error"


def interrupted(o):
    """The marker Claude Code writes when you press Esc on a turn (no turn_duration follows)."""
    if o.get("type") != "user" or o.get("isSidechain"):
        return False
    c = (o.get("message") or {}).get("content")
    t = c if isinstance(c, str) else result_text(c) if isinstance(c, list) else ""
    return t.lstrip().startswith(INTERRUPTED)


def one_line(s, n=100):
    s = " ".join(str(s or "").split())
    return s if len(s) <= n else s[:n - 1] + "…"


def entry_ts(o):
    return o.get("timestamp") or (o.get("attachment") or {}).get("timestamp")


def result_text(c):
    """A tool_result's content as text: a string, or text blocks (images as a placeholder)."""
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(x.get("text", "") if x.get("type") == "text" else "[image]"
                         for x in c if isinstance(x, dict) and x.get("type") in ("text", "image"))
    return ""


def notification_text(o):
    """The text of a <task-notification> entry (a background agent or command finished), else None.
    It arrives as a user entry when the session was idle, or folded into a running turn."""
    if o.get("type") == "attachment":
        a = o.get("attachment") or {}
        t = a.get("prompt") if a.get("type") == "queued_command" else None
    elif o.get("type") == "user":
        c = (o.get("message") or {}).get("content")
        t = c if isinstance(c, str) else result_text(c) if isinstance(c, list) and not any(
            isinstance(x, dict) and x.get("type") == "tool_result" for x in c) else None
    else:
        t = None
    return t if isinstance(t, str) and "<task-notification>" in t[:200] else None


def tool_title(name):
    """mcp__claude_ai_Atlassian__getJiraIssue → Atlassian · getJiraIssue; built-ins as they are."""
    parts = name.split("__")
    if len(parts) >= 3 and parts[0] == "mcp":
        return f"{re.sub(r'^claude_ai_', '', parts[1])} · {'__'.join(parts[2:])}"
    return name


def tool_label(name, inp):
    """The one-line gist of a tool call: the command, the file, the pattern, the agent's job…"""
    inp = inp if isinstance(inp, dict) else {}
    def base(p):
        p = str(p or "").rstrip("/")
        return os.path.basename(p) or p
    if name == "Bash":
        # "cd <repo> && make test" is "make test": the directory is noise in a one-line gist.
        return one_line(re.sub(r"^\s*cd\s+(\"[^\"]*\"|'[^']*'|\S+)\s*(&&|;)\s*", "", str(inp.get("command") or "")))
    if name in ("Edit", "MultiEdit", "Write", "Read", "NotebookEdit"):
        label = base(inp.get("file_path") or inp.get("notebook_path"))
        if name == "Read" and inp.get("offset"):
            label += f":{inp['offset']}"
        return label
    if name in ("Grep", "Glob"):
        return one_line(str(inp.get("pattern") or "") + (f"  in {base(inp['path'])}" if inp.get("path") else ""))
    if name in ("Agent", "Task"):
        return one_line(inp.get("description") or inp.get("prompt"))
    if name == "AskUserQuestion":
        qs = inp.get("questions")
        q0 = qs[0] if isinstance(qs, list) and qs else {}
        return one_line(q0.get("question") if isinstance(q0, dict) else "")
    for k in ("description", "query", "url", "skill", "pattern", "command", "file_path", "title", "name", "summary"):
        if isinstance(inp.get(k), str) and inp[k].strip():
            return one_line(inp[k])
    return one_line(next((v for v in inp.values() if isinstance(v, str) and v.strip()), ""))


def tool_stat(name, tur):
    """What a finished call changed, where that fits in a few characters: "+12 −3" for an edit."""
    if not isinstance(tur, dict):
        return None
    if name in ("Write",) and tur.get("type") == "create":
        return f"new · {len(str(tur.get('content') or '').splitlines())} lines"
    hunks = tur.get("structuredPatch")
    if name in ("Edit", "MultiEdit", "Write") and isinstance(hunks, list):
        add = sum(1 for h in hunks for ln in (h or {}).get("lines") or [] if ln.startswith("+"))
        rem = sum(1 for h in hunks for ln in (h or {}).get("lines") or [] if ln.startswith("-"))
        return f"+{add} −{rem}"
    return None


def peek_timeline(entries):
    """A transcript as Peek shows it, oldest first: the messages (see message_text) and, between
    them, Claude's tool calls, each one {"kind": "tool", id, name, title, label, ts, status, …}.
    status: ok | error | pending (no result yet: running, or cut short) | background (launched in
    the background; becomes ok, error or stopped when its task notification arrives, or stopped
    once TaskStop ends it) | stopped."""
    items, tools, last_user = [], {}, None
    by_bg, stops = {}, {}   # background id → its row; a TaskStop call's id → the id it stops
    for o in entries:
        if o.get("isSidechain"):
            continue
        ts = entry_ts(o)
        c = (o.get("message") or {}).get("content")
        at = len(items)   # an entry holding text before its tool calls shows the text first
        text_first = False
        if o.get("type") == "assistant" and isinstance(c, list):
            kinds = [x.get("type") for x in c if isinstance(x, dict)]
            text_first = "text" in kinds and kinds.index("text") < (kinds.index("tool_use") if "tool_use" in kinds else len(kinds))
            for x in c:
                if isinstance(x, dict) and x.get("type") == "tool_use" and x.get("name") in STOP_TOOLS:
                    inp = x.get("input") if isinstance(x.get("input"), dict) else {}
                    stops[x.get("id")] = inp.get("task_id") or inp.get("shell_id") or inp.get("bash_id")
                if isinstance(x, dict) and x.get("type") == "tool_use" and x.get("id") \
                        and x.get("name") not in TODO_TOOLS:
                    name = x.get("name") or "?"
                    it = {"kind": "tool", "id": x["id"], "name": name, "title": tool_title(name),
                          "label": tool_label(name, x.get("input")), "ts": ts, "status": "pending"}
                    tools[x["id"]] = it
                    items.append(it)
        elif o.get("type") == "user" and isinstance(c, list):
            results = [x for x in c if isinstance(x, dict) and x.get("type") == "tool_result"]
            tur = o.get("toolUseResult") if len(results) == 1 else None
            for x in results:
                # A TaskStop that worked ends the background call it names.
                target = by_bg.get(stops.get(x.get("tool_use_id")))
                if target and not x.get("is_error") and target["status"] == "background":
                    target.update(status="stopped", endTs=ts, bg="stopped")
                it = tools.get(x.get("tool_use_id"))
                if not it:
                    continue
                it["endTs"] = ts
                if x.get("is_error"):
                    it["status"] = "error"
                elif background_id(tur) or (isinstance(tur, dict) and tur.get("isAsync")):
                    it["status"] = "background"
                    if background_id(tur):
                        by_bg[background_id(tur)] = it
                else:
                    it["status"] = "ok"
                stat = tool_stat(it["name"], tur)
                if stat:
                    it["stat"] = stat
        note = notification_text(o)
        if note:
            # It names the call by its tool_use id, or only by the task's own id (an agent's
            # agentId); a resumed agent's later notifications name the SendMessage call instead.
            # One notification can list several tasks (those an ended session left running).
            m = NOTE_ID.search(note)
            st = (NOTE_STATUS.search(note) or [None, ""])[1].strip()
            for it in [tools.get(m.group(1).strip()) if m else None] + [by_bg.get(k.strip()) for k in NOTE_TASK.findall(note)]:
                if it and it["status"] == "background":
                    it.update(status=note_status(st), endTs=ts, bg=st or "done")
            continue
        t = message_text(o)
        if not t:
            continue
        role = message_role(o)
        if role == "user":
            # The same prompt is now and then written twice: as the user entry that starts a
            # turn and, a moment later, as a queued_command folded into it. Show it once.
            if o.get("type") == "attachment" and last_user and last_user["text"] == t:
                a, b = ts_seconds(last_user["ts"]), ts_seconds(ts)
                if a is not None and b is not None and abs(b - a) <= 10:
                    continue
            last_user = {"text": t, "ts": ts}
        items.insert(at if text_first else len(items), {"kind": "msg", "role": role, "text": t, "ts": ts})
    return items


def peek_window(path, n):
    """The last n messages with the tool calls among them (at most PEEK_TOOLS_MAX, newest kept),
    and the transcript entries they were read from. Reads further back until it has n messages:
    screenshots sit in the transcript as base64, so a session that looked at a few dozen of them
    has only a handful of messages in its last 6 MB. A whole 10 MB transcript parses in ~15 ms."""
    for nbytes in (600_000, 6_000_000, PEEK_BYTES_MAX):
        entries = transcript_tail(path, nbytes)
        items = peek_timeline(entries)
        at = [i for i, it in enumerate(items) if it["kind"] == "msg"]
        if len(at) >= n:
            items = items[at[-n]:]
            break
    tools = [it for it in items if it["kind"] == "tool"]
    if len(tools) > PEEK_TOOLS_MAX:
        drop = {id(it) for it in tools[:-PEEK_TOOLS_MAX]}
        items = [it for it in items if id(it) not in drop]
    return items, entries


def recent_messages(path, n=8):
    items, _ = peek_window(path, n)
    return [{"role": it["role"], "text": it["text"], "ts": it["ts"]} for it in items if it["kind"] == "msg"]


def turn_stats(entries):
    """The turn in progress, or else the last one: when it started, Claude's output tokens in it,
    how long it took (finished turns: Claude Code logs a turn_duration when one ends), and the
    context size at its last reply."""
    ends = [i for i, o in enumerate(entries) if o.get("type") == "system" and o.get("subtype") == "turn_duration"]
    def spoke(o):
        return not o.get("isSidechain") and (o.get("type") == "assistant" or (
            o.get("type") == "user" and (message_text(o) or notification_text(o))))
    lo, hi, ms = 0, len(entries), None
    if ends and not any(spoke(o) for o in entries[ends[-1] + 1:]):
        lo = ends[-2] + 1 if len(ends) > 1 else 0
        hi, ms = ends[-1], entries[ends[-1]].get("durationMs")
    elif ends:
        lo = ends[-1] + 1
    else:  # no turn markers (older Claude Code): from the last thing the user said
        lo = next((i for i in range(len(entries) - 1, -1, -1)
                   if message_role(entries[i]) == "user" and message_text(entries[i])
                   and not interrupted(entries[i]) and not notification_text(entries[i])), 0)
    # Esc on a turn writes no turn_duration, only a marker: the turn ends there, and the next
    # one starts after it (else it would count the interrupted turn and the idle time since).
    cut = [i for i in range(lo, hi) if interrupted(entries[i])]
    if cut and ms is None:
        if any(spoke(o) and not interrupted(o) for o in entries[cut[-1] + 1:hi]):
            lo = cut[-1] + 1
        else:
            prev = cut[-2] + 1 if len(cut) > 1 else lo
            seg = entries[prev:cut[-1]]
            a = next((entry_ts(o) for o in seg if spoke(o) and entry_ts(o)), None)
            b = entry_ts(entries[cut[-1]])
            if a and b and ts_seconds(a) is not None and ts_seconds(b) is not None:
                lo, hi, ms = prev, cut[-1], int((ts_seconds(b) - ts_seconds(a)) * 1000)
    seg = entries[lo:hi]
    start = next((entry_ts(o) for o in seg if spoke(o) and entry_ts(o)), None)
    seen, out, ctx = set(), 0, None
    for o in seg:
        if o.get("type") != "assistant" or o.get("isSidechain"):
            continue
        msg = o.get("message") or {}
        u = msg.get("usage") or {}
        if msg.get("id") not in seen:   # one reply is written as several entries, same usage
            seen.add(msg.get("id"))
            out += u.get("output_tokens") or 0
        ctx = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")) or ctx
    if start is None:
        return None
    return {"start": start, "done": ms is not None, "ms": ms, "tokens": out, "context": ctx}


def latest_todos(entries):
    """Claude's own todo list as it last stood: the latest TodoWrite, or the list the
    TaskCreate / TaskUpdate tools have built since. [{text, status, active}], or None."""
    items, creating = None, {}
    for o in entries:
        if o.get("isSidechain"):
            continue
        c = (o.get("message") or {}).get("content")
        if not isinstance(c, list):
            continue
        for x in c:
            if not isinstance(x, dict):
                continue
            inp = x.get("input") if isinstance(x.get("input"), dict) else {}
            if x.get("type") == "tool_use" and x.get("name") == "TodoWrite" and isinstance(inp.get("todos"), list):
                items = {str(i): {"text": t.get("content") or "", "status": t.get("status") or "pending",
                                  "active": t.get("activeForm") or ""}
                         for i, t in enumerate(inp["todos"]) if isinstance(t, dict)}
            elif x.get("type") == "tool_use" and x.get("name") == "TaskCreate":
                creating[x.get("id")] = inp
            elif x.get("type") == "tool_use" and x.get("name") == "TaskUpdate" and items is not None:
                t = items.get(str(inp.get("taskId")))
                if t is not None:
                    if inp.get("status") == "deleted":
                        items.pop(str(inp.get("taskId")))
                        continue
                    t["status"] = inp.get("status") or t["status"]
                    t["text"] = inp.get("subject") or t["text"]
                    t["active"] = inp.get("activeForm") or t["active"]
            elif x.get("type") == "tool_result" and x.get("tool_use_id") in creating and not x.get("is_error"):
                inp = creating.pop(x["tool_use_id"])
                tur = o.get("toolUseResult")
                tid = ((tur.get("task") or {}).get("id") if isinstance(tur, dict) else None) \
                    or (re.search(r"#(\d+)", result_text(x.get("content"))) or [None, None])[1]
                if tid is not None:
                    items = items if items is not None else {}
                    items[str(tid)] = {"text": inp.get("subject") or "", "status": "pending",
                                       "active": inp.get("activeForm") or ""}
    return list(items.values()) if items else None


def tool_detail(path, tool_id, cap_in=100_000, cap_out=200_000):
    """One tool call in full, for an opened Peek row: its input and output as text (an edit's
    output is its diff; a background job's, its result once it has finished)."""
    use = res = tur = note = None
    use_ts = end_ts = None
    bg = stop_ids = None   # once launched in the background: its own id, and TaskStop calls on it
    stopped = None
    with open(path, encoding="utf-8", errors="ignore") as f:
        for line in f:
            if tool_id not in line and not (bg and bg in line) \
                    and not (stop_ids and any(i in line for i in stop_ids)):
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            # Only the conversation's own entries: request records and snapshots repeat the
            # call without its toolUseResult (an edit's diff lives there).
            c = (o.get("message") or {}).get("content") if o.get("type") in ("user", "assistant") \
                and not o.get("isSidechain") else None
            for x in c if isinstance(c, list) else []:
                if isinstance(x, dict) and x.get("type") == "tool_use" and x.get("id") == tool_id and not use:
                    use, use_ts = x, entry_ts(o)
                elif isinstance(x, dict) and x.get("type") == "tool_result" and x.get("tool_use_id") == tool_id and not res:
                    res, end_ts = x, entry_ts(o)
                    tur = o.get("toolUseResult")
                    bg = background_id(tur) if not x.get("is_error") else None
                    stop_ids = set() if bg else None
                elif bg and isinstance(x, dict) and x.get("type") == "tool_use" and x.get("name") in STOP_TOOLS \
                        and bg in json.dumps(x.get("input") or {}):
                    stop_ids.add(x.get("id"))
                elif stop_ids and isinstance(x, dict) and x.get("type") == "tool_result" \
                        and x.get("tool_use_id") in stop_ids and not x.get("is_error") and not note and not stopped:
                    stopped = entry_ts(o)
            t = notification_text(o)
            m = NOTE_ID.search(t) if t else None
            if t and not note and ((m and m.group(1).strip() == tool_id)
                                   or (bg and bg in [k.strip() for k in NOTE_TASK.findall(t)])):
                note, end_ts = t, entry_ts(o)
    if not use:
        return None
    name, inp = use.get("name") or "?", use.get("input") if isinstance(use.get("input"), dict) else {}
    hunks = tur.get("structuredPatch") if isinstance(tur, dict) else None
    diff = "\n".join(f"@@ -{h.get('oldStart')},{h.get('oldLines')} +{h.get('newStart')},{h.get('newLines')} @@\n"
                     + "\n".join(h.get("lines") or []) for h in hunks if isinstance(h, dict)) if hunks else ""
    if name == "Bash":
        text_in = (f"# {inp['description']}\n" if inp.get("description") else "") + f"$ {inp.get('command', '')}"
    elif name in ("Edit", "MultiEdit") and not diff:
        text_in = f"{inp.get('file_path', '')}\n--- old\n{inp.get('old_string', '')}\n--- new\n{inp.get('new_string', '')}"
    elif name in ("Edit", "MultiEdit", "Read"):
        text_in = str(inp.get("file_path", "")) + "".join(
            f"  {k}={inp[k]}" for k in ("offset", "limit", "replace_all") if inp.get(k))
    elif name == "Write":
        text_in = f"{inp.get('file_path', '')}\n\n{inp.get('content', '')}"
    elif name in ("Agent", "Task"):
        text_in = f"{inp.get('description', '')}" + (f"  ({inp['subagent_type']})" if inp.get("subagent_type") else "") \
            + f"\n\n{inp.get('prompt', '')}"
    else:
        text_in = json.dumps(inp, ensure_ascii=False, indent=1)
    if diff and name in ("Edit", "MultiEdit", "Write") and not (res or {}).get("is_error"):
        text_out = diff
    else:
        text_out = result_text((res or {}).get("content"))
    if note:
        r = NOTE_RESULT.search(note)
        st = (NOTE_STATUS.search(note) or [None, ""])[1].strip()
        text_out = (text_out + "\n\n" if text_out else "") + f"— {st or 'finished'} —\n" + (r.group(1).strip() if r else "")
    elif stopped:
        text_out = (text_out + "\n\n" if text_out else "") + "— stopped (TaskStop) —"
        end_ts = stopped
    return {"id": tool_id, "name": name, "title": tool_title(name), "ts": use_ts, "endTs": end_ts,
            "error": bool((res or {}).get("is_error")), "done": res is not None,
            "input": text_in[:cap_in], "inputChars": len(text_in),
            "output": text_out[:cap_out], "outputChars": len(text_out)}


def session_title(entries):
    for o in reversed(entries):
        if o.get("type") == "custom-title" and o.get("customTitle"):
            return o["customTitle"]
    return None


def pet_session(sid):
    return load_json(os.path.join(PET_SESSIONS, f"{sid}.json"), None) if sid and "/" not in sid else None


def live_sessions():
    state = load_state()
    out = []
    if not os.path.isdir(PET_SESSIONS):
        return out
    for name in os.listdir(PET_SESSIONS):
        if not name.endswith(".json"):
            continue
        d = load_json(os.path.join(PET_SESSIONS, name), None)
        if not isinstance(d, dict) or not pid_alive(d.get("pid")):
            continue
        sid = d.get("sessionId") or name[:-5]
        last = None
        # Screenshots and big tool results can fill the tail; widen once if needed.
        for nbytes in (300_000, 3_000_000):
            entries = transcript_tail(d.get("transcript"), nbytes)
            for o in reversed(entries):
                if o.get("type") == "assistant":
                    # A reply that was only bookkeeping (the answer to a write-back nudge) is not
                    # what the session last said: keep looking.
                    last = strip_hq_blocks(message_text(o) or "", ("hq-resolved", "hq-update"))
                    if last:
                        break
            if last:
                break
        out.append({
            "sessionId": sid,
            "title": session_title(entries),
            "project": d.get("project") or os.path.basename(d.get("cwd", "")),
            "cwd": d.get("cwd"),
            "state": d.get("state"),
            "waitingOn": d.get("waitingOn"),
            "updatedAt": d.get("updatedAt"),
            "terminal": d.get("terminal"),
            "transcript": d.get("transcript"),
            "task": state.get(sid, {}).get("task"),
            "lastText": (last or "")[:400],
        })
    out.sort(key=lambda s: s.get("updatedAt") or "", reverse=True)
    return out


# ---------------------------------------------------------------- onboarding scan
# Reads the Claude Code transcripts already on this machine and proposes projects (one per git
# repository, or per directory outside a repository) with the sessions that worked in them.
# Deterministic and read-only unless --apply-projects; turning sessions into task cards needs
# judgment, which is what the /hq-onboard command (Claude) does with this output.
SCAN_SKIP = re.compile(r"-private-|-var-folders-|^-tmp-|-T-tgkb-|scratchpad")


def transcript_head(path, nbytes=96_000):
    out = []
    with open(path, "rb") as f:
        chunk = f.read(nbytes).decode("utf-8", "ignore").splitlines()
    for line in chunk[:-1] if len(chunk) > 1 else chunk:
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


def git_root(path):
    home = os.path.realpath(os.path.expanduser("~"))
    cur = os.path.realpath(path)
    while cur not in ("/", home) and os.path.dirname(cur) != cur:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        cur = os.path.dirname(cur)
    return None


def scan_sessions(days):
    base = os.path.expanduser("~/.claude/projects")
    cutoff = time.time() - days * 86400
    state = load_state()
    rows = []
    for slug in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        if SCAN_SKIP.search(slug):
            continue
        d = os.path.join(base, slug)
        if not os.path.isdir(d):
            continue
        for name in os.listdir(d):
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(d, name)
            mtime = os.path.getmtime(path)
            if mtime < cutoff:
                continue
            head = transcript_head(path)
            tail = transcript_tail(path, 250_000)
            cwd = next((o.get("cwd") for o in head + tail if o.get("cwd")), None)
            if not cwd:
                continue
            first = next((t for t in (message_text(o) for o in head if message_role(o) == "user") if t), "")
            users = sum(1 for o in tail if message_role(o) == "user" and message_text(o))
            sid = name[:-6]
            pet = pet_session(sid) or {}
            rows.append({
                "sessionId": sid, "cwd": cwd, "title": session_title(tail) or session_title(head),
                "first": first[:200], "last": dt.datetime.fromtimestamp(mtime).astimezone().isoformat(timespec="minutes"),
                "turns_in_tail": users, "live": pid_alive(pet.get("pid")) if pet else False,
                "task": state.get(sid, {}).get("task"), "transcript": path,
            })
    rows.sort(key=lambda r: r["last"], reverse=True)
    return rows


def scan_projects(sessions):
    home = os.path.realpath(os.path.expanduser("~"))
    skip = {"/", home, os.path.realpath(hq_root(required=False) or "/")}
    groups = {}
    for r in sessions:
        root = git_root(r["cwd"]) or os.path.realpath(r["cwd"])
        if root in skip or not os.path.isdir(root):
            continue
        g = groups.setdefault(root, {"path": root, "name": safe_name(os.path.basename(root)), "sessions": [], "last": ""})
        g["sessions"].append(r["sessionId"])
        g["last"] = max(g["last"], r["last"])
        r["root"] = root
    out = sorted(groups.values(), key=lambda g: g["last"], reverse=True)
    for g in out:
        g["existing"] = project_for_path(g["path"]) or None
        g["count"] = len(g["sessions"])
    return out


def cmd_scan(args):
    sessions = scan_sessions(args.days)
    projects = scan_projects(sessions)
    if args.apply_projects:
        only = set(x.strip() for x in (args.only or "").split(",") if x.strip())
        taken = set(x["name"] for x in load_projects())
        added = []
        for g in projects:
            if g["existing"] or (only and g["name"] not in only and g["path"] not in only):
                continue
            name, n = safe_name(g["name"]), 2
            while name in taken:
                suffix = f"-{n}"
                name, n = safe_name(g["name"])[:40 - len(suffix)] + suffix, n + 1
            save_projects(load_projects() + [{"name": name, "paths": [g["path"]]}])
            taken.add(name)
            added.append(name)
        assigned = 0
        for path in card_paths():
            meta = parse_card(path)
            if not meta.get("project"):
                guess = project_for_dirs(meta.get("workdirs") if isinstance(meta.get("workdirs"), list) else [])
                if guess:
                    set_fields(path, {"project": guess, "updated": meta.get("updated", today())})
                    assigned += 1
        print(json.dumps({"added": added, "assigned": assigned}) if args.json
              else f"added {len(added)} project(s): {', '.join(added) or '-'}; assigned {assigned} task(s)")
        return
    if args.json:
        print(json.dumps({"days": args.days, "projects": projects, "sessions": sessions}, ensure_ascii=False, indent=1))
        return
    print(f"Sessions in the last {args.days} days: {len(sessions)}\n")
    print("Suggested projects:")
    for g in projects:
        flag = f"(already: {g['existing']})" if g["existing"] else "(new)"
        print(f"  {g['name']:<24} {g['count']:>3} session(s)  last {g['last'][:16]}  {flag}  {g['path']}")
    print("\nSessions:")
    for r in sessions:
        live = "live " if r["live"] else "     "
        print(f"  {r['sessionId'][:8]} {live}{r['last'][:16]}  {os.path.basename(r.get('root') or r['cwd']):<20} "
              f"{(r['title'] or r['first'] or '')[:60]}")
    print("\nCreate the new projects: hq scan --apply-projects [--only name,name]"
          "\nTurn sessions into task cards: run /hq-onboard in Claude Code.")


def cmd_sessions(args):
    s = live_sessions()
    if args.json:
        print(json.dumps(s, ensure_ascii=False, indent=1))
        return
    for x in s:
        print(f"{x['sessionId'][:8]}  {x['state'] or '?':<8} {x['task'] or '-':<6} "
              f"{x['project']:<20} {x['title'] or ''}")


PET_JUMPS = os.path.expanduser("~/.claude/pet/jumps.jsonl")
JUMP_STATES = ["permission", "question", "replied", "working", "agent", "interrupted", "idle", "gone"]
JUMP_SOURCES = ["board-card", "board-sessions", "board-peek", "board-context", "board",
                "pet-list", "pet-finished", "pet-notice", "hotkey"]
PEEK_RECENT = 600   # a Peek this many seconds before the jump counts as "read it first"


def jump_summary(days, now=None):
    """Jumps of the last `days` days from the pet's jump log, counted by state x source."""
    since = (now or time.time()) - days * 86400
    events = []
    try:
        with open(PET_JUMPS, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    e = json.loads(line)
                    t = dt.datetime.fromisoformat(str(e["at"]).replace("Z", "+00:00"))
                except (ValueError, KeyError, TypeError):
                    continue
                if t.tzinfo is None:   # the pet writes UTC; a stamp without a zone is read as UTC too
                    t = t.replace(tzinfo=dt.timezone.utc)
                if t.timestamp() >= since:
                    events.append(e)
    except FileNotFoundError:
        pass
    grid, by_state, by_source, peeked = {}, {}, {}, {}
    for e in events:
        st, src = (str(e.get(k)) if e.get(k) not in (None, "") else "?" for k in ("state", "source"))
        grid.setdefault(st, {}).setdefault(src, 0)
        grid[st][src] += 1
        by_state[st] = by_state.get(st, 0) + 1
        by_source[src] = by_source.get(src, 0) + 1
        if isinstance(e.get("peekedAgo"), int) and e["peekedAgo"] <= PEEK_RECENT:
            peeked[st] = peeked.get(st, 0) + 1
    order = lambda known, seen: [k for k in known if k in seen] + sorted(k for k in seen if k not in known)
    return {"days": days, "total": len(events), "grid": grid, "byState": by_state, "bySource": by_source,
            "peekedFirst": peeked, "states": order(JUMP_STATES, by_state),
            "sources": order(JUMP_SOURCES, by_source)}


def cmd_jumps(args):
    r = jump_summary(args.days)
    if args.json:
        print(json.dumps(r, ensure_ascii=False, indent=1))
        return
    if not r["total"]:
        print(f"no jumps in the last {args.days} days (log: {PET_JUMPS})")
        return
    cols = r["sources"]
    w = max([len("state")] + [len(x) for x in r["states"]])
    print(f"{r['total']} jumps in the last {args.days} days, by state x where it was clicked\n")
    print(f"{'state':<{w}}  " + "  ".join(f"{c:>{len(c)}}" for c in cols) + "  total  peeked")
    for st in r["states"]:
        row = r["grid"].get(st, {})
        print(f"{st:<{w}}  " + "  ".join(f"{row.get(c, 0) or '.':>{len(c)}}" for c in cols)
              + f"  {r['byState'][st]:>5}  {r['peekedFirst'].get(st, 0):>6}")
    print(f"{'total':<{w}}  " + "  ".join(f"{r['bySource'][c]:>{len(c)}}" for c in cols) + f"  {r['total']:>5}")
    print(f"\npeeked = its Peek was open on the board in the {PEEK_RECENT // 60} minutes before the jump")


def find_transcript(prefix):
    """A session's transcript by id or id prefix: the pet's record if the session is live,
    else a search of ~/.claude/projects (so closed sessions can still be read)."""
    if not prefix or "/" in prefix or len(prefix) < 6:
        return None, False
    for name in os.listdir(PET_SESSIONS) if os.path.isdir(PET_SESSIONS) else []:
        if name.startswith(prefix):
            d = load_json(os.path.join(PET_SESSIONS, name), {})
            if d.get("transcript") and os.path.exists(d["transcript"]):
                return d["transcript"], pid_alive(d.get("pid"))
    import glob
    hits = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{glob.escape(prefix)}*.jsonl"))
    if not hits:
        return None, False
    return max(hits, key=os.path.getmtime), False


def cmd_peek(args):
    path, live = find_transcript(args.session)
    if args.tool:
        d = tool_detail(path, args.tool) if path else None
        if not d:
            die(f"no tool call {args.tool} in session {args.session}")
        if args.json:
            print(json.dumps(d, ensure_ascii=False, indent=1))
        else:
            print(f"[{d['title']}]\n{d['input']}\n\n{d['output']}")
        return
    items, entries = peek_window(path, args.n) if path else ([], [])
    msgs = [{"role": it["role"], "text": it["text"], "ts": it["ts"]} for it in items if it["kind"] == "msg"]
    if args.json:
        if args.meta:
            cwd = next((o.get("cwd") for o in reversed(entries) if o.get("cwd")), None)
            # items: the messages with the tool calls between them; turn: the turn in progress
            # (or the last one); todos: Claude's own todo list. `messages` stays for older readers.
            print(json.dumps({"session": os.path.basename(path)[:-6] if path else args.session,
                              "found": bool(path), "live": live, "title": session_title(entries),
                              "cwd": cwd, "messages": msgs, "items": items,
                              "turn": turn_stats(entries), "todos": latest_todos(entries)},
                             ensure_ascii=False, indent=1))
        else:
            print(json.dumps(msgs, ensure_ascii=False, indent=1))
        return
    for m in msgs:
        print(f"[{m['role']}] {m['text']}\n")


def cmd_history(args):
    """The sessions that have worked on a task (newest first), with what's needed to resume one:
    full id, the directory it ran in, its name, when it was last active, its last words."""
    meta = parse_card(find_card(args.task))
    seen, rows = set(), []
    for short in reversed(list(meta.get("sessions") or [])):
        path, live = find_transcript(str(short))
        if not path or path in seen:
            continue
        seen.add(path)
        entries = transcript_tail(path, 300_000)
        gists = (strip_hq_blocks(message_text(o) or "", ("hq-resolved", "hq-update"))
                 for o in reversed(entries) if o.get("type") == "assistant")
        last = next((g for g in gists if g), "")
        rows.append({
            "sessionId": os.path.basename(path)[:-6],
            "cwd": next((o.get("cwd") for o in reversed(entries) if o.get("cwd")), None),
            "title": session_title(entries),
            "lastAt": dt.datetime.fromtimestamp(os.path.getmtime(path)).astimezone().isoformat(timespec="seconds"),
            "live": live,
            "lastText": " ".join(last.split())[:160],
        })
    rows.sort(key=lambda r: r["lastAt"], reverse=True)
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return
    for r in rows:
        print(f"{r['sessionId'][:8]}  {r['lastAt'][:16]}  {'live ' if r['live'] else ''}{r['title'] or ''}  {r['cwd'] or ''}")


# ---------------------------------------------------------------- status
# `hq status`: where a task stands, put together by code instead of a session grepping cards and
# transcripts — the card's own account (status, next, Status section, latest log), what is still
# open and how long it has waited, its sessions (state, last activity, context, last words) — and
# flags where these disagree. Read-only. Kept to about 1k tokens a task: long lists are cut, with
# a count of what was left out.
STATUS_STALE_DAYS = 7          # an open card not updated for this long
STATUS_IDLE_MINUTES = 30       # nothing running this long while the card says it waits on a run
STATUS_BEHIND_MINUTES = 10     # a session worked this long after the card was last written
CARD_MAX_BYTES = 16_000        # a card past any of these is over budget: every session that
CARD_MAX_REFS = 30             # starts on the task reads all of it
CARD_MAX_TODOS = 30
STATUS_TODOS_SHOWN = 6         # per owner group, newest kept
STATUS_ASKS_SHOWN = 5
STATUS_SESSIONS_SHOWN = 3      # the live ones first, then the most recent
STATUS_MSGS = 3                # last words of the most recent session (one for the others)
# The card says it waits on something that runs by itself — a build, a watcher, a job — as
# opposed to a person. A clause needs both a cue and a machine word.
# ("a file watcher" or "测试等问题" is no wait; "to run the numbers" and "PR #1234" are a person's.)
WAIT_CUE_RE = re.compile(
    r"\bwait(?:ing|s)?\s+(?:on|for)\b|\b(?:watching|monitoring|polling)\b"
    r"|\b(?:when|once|after|until)\b[^.;\n]{0,80}?\b(?:fires?|finish(?:es|ed)?|completes?|pass(?:es)?|lands?|done|ends?)\b"
    r"|等(?!你|问题|方面|内容|情况|工作|事|文件|地方|等)|盯|完成后|结束后|出结果|跑完(?:后|再|就|之后|了再)", re.I)
WAIT_MACHINE_RE = re.compile(
    r"\b(?:builds?|jobs?|ci|jenkins|pipelines?|watcher|tests?|deploy(?:ment)?|workflow|cluster)\b"
    r"|(?<!\bto )\bruns?\b|(?<!PR )(?<!PR)#\d{3,}|构建|跑|流水线|部署|集群", re.I)
LOG_LINE_RE = re.compile(r"^- (\d{4}-\d\d-\d\d \d\d:\d\d(?::\d\d)?): (.*)$")
LOG_HEADING_RE = re.compile(r"^##[ \t]*(?:Log|决策记录)\b.*?\n(.*?)(?=^##\s|\Z)", re.M | re.S | re.I)
OLDER_200K = ("claude-3", "claude-haiku-4", "claude-sonnet-4", "claude-opus-4-0", "claude-opus-4-1",
              "claude-opus-4-5", "claude-opus-4-6", "claude-opus-4-2")


def context_budget(model):
    """Tokens at which a session on `model` compacts — the pet's ContextBudget: the model's window,
    lowered by /autocompact (settings.json modelSettings / env)."""
    m = (model or "").lower().strip()
    window = whole = 1_000_000 if "[1m]" in m or not m.startswith(OLDER_200K) else 200_000
    key = re.sub(r"-\d{8}$", "", m.split("[", 1)[0])
    s = load_json(os.path.expanduser("~/.claude/settings.json"), {})
    s = s if isinstance(s, dict) else {}
    env = s.get("env") if isinstance(s.get("env"), dict) else {}

    def num(v):
        try:
            return float(str(v).strip())
        except (TypeError, ValueError):
            return None
    models = {str(k).lower(): v for k, v in (s.get("modelSettings") or {}).items()} \
        if isinstance(s.get("modelSettings"), dict) else {}
    per = {k: num((v or {}).get("autoCompactWindow")) for k, v in models.items() if isinstance(v, dict)}
    by_key = {re.sub(r"-\d{8}$", "", k.split("[", 1)[0]): w for k, w in per.items() if w and w > 0}
    env_w = num(env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW"))
    if env_w and env_w > 0:
        window = min(int(env_w), whole)
    elif per.get(m) and per[m] > 0:
        window = min(int(per[m]), whole)
    elif by_key.get(key):
        window = min(int(by_key[key]), whole)
    pct = num(env.get("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"))
    if pct and 0 < pct <= 100:
        window = max(1, int(window * pct / 100))
    return window


def local_dt(ts):
    """A transcript / ask / todo time as an aware local datetime, or None."""
    if ts is None:
        return None
    if isinstance(ts, (int, float)):
        return dt.datetime.fromtimestamp(ts).astimezone()
    try:
        t = dt.datetime.fromisoformat(str(ts).strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return t.astimezone() if t.tzinfo else t.astimezone()   # naive = local


def iso(t):
    return t.isoformat(timespec="seconds") if t else None


def short_time(t, now):
    """11-23 09:53, or 09:53 for today."""
    if not t:
        return "?"
    return t.strftime("%H:%M") if t.date() == now.date() else t.strftime("%m-%d %H:%M")


def span(seconds):
    """How long, short: 45m, 3h, 2d."""
    if seconds is None:
        return "?"
    m = max(0, int(seconds // 60))
    if m < 60:
        return f"{m}m"
    if m < 48 * 60:
        return f"{m // 60}h"
    return f"{m // 1440}d"


def card_log(body, n=3):
    """The card's last n log entries, leaving out todo ticks (the todo lists show those)."""
    m = LOG_HEADING_RE.search(body + "\n")
    out = []
    for line in (m.group(1) if m else "").splitlines():
        x = LOG_LINE_RE.match(line.strip())
        if x and not re.match(r"todo #\d+ → ", x.group(2)):
            out.append({"at": x.group(1), "text": x.group(2)})
    return out[-n:]


def card_state_lines(body):
    m = STATUS_HEADING_RE.search(body + "\n")
    lines = [l.strip() for l in (m.group(1) if m else "").splitlines()]
    return [l for l in lines if l and not l.startswith("<!--") and not is_placeholder(l)]


def waiting_on_a_run(texts):
    """The first clause of the card's next / status that says it waits on a run, build, watcher …"""
    for t in texts:
        for clause in re.split(r"[;；。\n]|(?<=[a-z0-9)])\.\s", t or ""):
            if WAIT_CUE_RE.search(clause) and WAIT_MACHINE_RE.search(clause):
                return one_line(clause.strip(" ,:-"), 120)
    return None


def reply_tokens(o):
    """Tokens a reply's request sent; 0 for an API error, which is written as a reply with none
    (and model "<synthetic>")."""
    u = (o.get("message") or {}).get("usage") or {}
    return sum(u.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")
               if isinstance(u.get(k), int))


def session_status(sid, path, now, n_msgs):
    """One session as `hq status` shows it."""
    rec = pet_session(sid)
    live = bool(isinstance(rec, dict) and pid_alive(rec.get("pid")))
    entries = transcript_tail(path, 600_000)
    items = peek_timeline(entries)
    acts = [local_dt(entry_ts(o)) for o in entries
            if o.get("type") in ("user", "assistant") and not o.get("isSidechain") and entry_ts(o)]
    last = max([a for a in acts if a], default=None) or local_dt(os.path.getmtime(path))
    tools = [it for it in items if it["kind"] == "tool"]
    # When a tool was called, not when it ended: a background job's end is its completion notice
    # arriving, which is not the session doing anything.
    last_tool = max([local_dt(it.get("ts")) for it in tools if it.get("ts")] or [None],
                    key=lambda t: t or dt.datetime.min.replace(tzinfo=dt.timezone.utc))
    background = [one_line(f"{it['title']}: {it['label']}", 80) for it in tools if it["status"] == "background"]
    st = {"busy": "working", "waiting": "waiting-on-you", "idle": "idle"}.get((rec or {}).get("state"), "idle") \
        if live else "ended"
    # Context: the last real reply's request, as the pet counts it (an API error has no tokens).
    reply = next((o for o in reversed(entries)
                  if o.get("type") == "assistant" and not o.get("isSidechain") and reply_tokens(o) > 0), None)
    ctx = None
    if reply:
        tokens = reply_tokens(reply)
        b = context_budget(reply.get("requestedModel") or (reply.get("message") or {}).get("model"))
        ctx = {"tokens": tokens, "budget": b, "percent": min(999, round(tokens * 100 / b))}
    msgs = []
    for it in reversed(items):
        if len(msgs) >= n_msgs:
            break
        if it["kind"] != "msg":
            continue
        text = strip_hq_blocks(it["text"]) if it["role"] == "assistant" else it["text"]
        if text.strip():
            msgs.append({"role": it["role"], "ts": iso(local_dt(it["ts"])), "text": one_line(text, 200)})
    msgs.reverse()
    return {"sessionId": sid, "title": session_title(entries), "live": live, "state": st,
            "lastAt": iso(last), "lastToolAt": iso(last_tool),
            "idleFor": int((now - last).total_seconds()) if last and st in ("idle", "ended") else None,
            "context": ctx, "background": background if live else [], "messages": msgs}


def task_sessions(meta, state, now, written):
    """The task's sessions, live first, then most recent: the ones bound to it now and the ones its
    card lists, except a session since bound to another task (its work is that task's now).
    Returns (shown, checked, total): the first STATUS_SESSIONS_SHOWN; those plus every other one
    that could raise a flag (live, or written to after the card); and how many there are."""
    bound = {sid: e.get("task") for sid, e in state.items() if isinstance(e, dict)}
    ids = [sid for sid, t in bound.items() if t == meta.get("id")]
    ids += [str(s) for s in (meta.get("sessions") or []) if s]
    found, seen = [], set()
    for sid in ids:
        path, live = find_transcript(sid)
        if not path or path in seen:
            continue
        full = os.path.basename(path)[:-6]
        if bound.get(full) not in (None, meta.get("id")):
            continue
        seen.add(path)
        found.append((full, path, live, os.path.getmtime(path)))
    found.sort(key=lambda x: (not x[2], -x[3]))
    shown, checked = [], []
    for i, (sid, path, live, mtime) in enumerate(found):
        if i < STATUS_SESSIONS_SHOWN:
            shown.append(session_status(sid, path, now, STATUS_MSGS if i == 0 else 1))
            checked.append(shown[-1])
        elif live or local_dt(mtime) > written + dt.timedelta(minutes=STATUS_BEHIND_MINUTES):
            checked.append(session_status(sid, path, now, 0))
    return shown, checked, len(found)


def todo_groups(meta, seen):
    """Open todos by owner (me / claude / others): newest STATUS_TODOS_SHOWN of each, with how long
    each has waited (its stamp, or when HQ first saw it)."""
    groups = {"me": [], "claude": [], "others": []}
    for t in meta.get("todos", []):
        if t["state"] != "open":
            continue
        owner = t.get("owner")
        since = local_dt(t.get("created") or seen.get(f"{meta.get('id')}|{t['text']}"))
        g = owner if owner in ("me", "claude") else "others"
        groups[g].append({"text": one_line(t["text"], 140), "owner": owner, "since": iso(since)})
    return {g: {"count": len(v), "items": v[-STATUS_TODOS_SHOWN:]} for g, v in groups.items()}


def task_status(meta, state, now, seen):
    card = meta["path"]
    written = local_dt(os.path.getmtime(card))
    size = os.path.getsize(card)
    refs = meta.get("refs") if isinstance(meta.get("refs"), list) else []
    state_lines = card_state_lines(meta["body"])
    asks = [a for a in read_asks(meta["dir"]) if a.get("state") == "open"]
    shown, sessions, n_sessions = task_sessions(meta, state, now, written)
    status = meta.get("status")
    is_open = status in OPEN_STATUSES
    flags = []

    def flag(kind, en, zh, **data):
        flags.append(dict({"kind": kind, "text": en, "text_zh": zh}, **data))

    # The card is behind its sessions: one called tools well after the card was last written and
    # is not mid-turn (working, or held at a prompt) — the turn ended without an hq-update.
    for s in sessions:
        t = local_dt(s.get("lastToolAt"))
        if s["state"] not in ("working", "waiting-on-you") and t and (t - written).total_seconds() > STATUS_BEHIND_MINUTES * 60:
            flag("card-behind",
                 f"card behind: session {s['sessionId'][:8]} worked until {short_time(t, now)}, card last written {short_time(written, now)}",
                 f"卡片落后：session {s['sessionId'][:8]} 一直干到 {short_time(t, now)}，卡片最后写入是 {short_time(written, now)}",
                 session=s["sessionId"], at=iso(t), cardWritten=iso(written))
            break
    # Nothing is running, yet the card says it waits on a run.
    waits = waiting_on_a_run([meta.get("next") or ""] + state_lines) if is_open else None
    if waits:
        running = [s for s in sessions if s["live"] and (s["state"] in ("working", "waiting-on-you") or s["background"])]
        quiet = max([local_dt(s["lastAt"]) for s in sessions if s.get("lastAt")] or [written])
        if not running and (now - quiet).total_seconds() > STATUS_IDLE_MINUTES * 60:
            who = "no live session" if not any(s["live"] for s in sessions) else "its sessions are idle with nothing in the background"
            who_zh = "没有活着的 session" if not any(s["live"] for s in sessions) else "session 空闲，后台也没有在跑的东西"
            flag("idle-waiting",
                 f"idle since {short_time(quiet, now)} ({who}), but the card says: {waits}",
                 f"从 {short_time(quiet, now)} 起没有动静（{who_zh}），但卡片说在等：{waits}",
                 since=iso(quiet), says=waits)
    age = age_days(meta)
    if is_open and age is not None and age >= STATUS_STALE_DAYS:
        flag("stale", f"not updated for {age} days (since {meta.get('updated')})",
             f"{age} 天没更新（上次 {meta.get('updated')}）", days=age)
    if status in ("done", "abandoned"):
        live = [s for s in sessions if s["live"]]
        if live:
            names = ", ".join(f"{s['sessionId'][:8]} ({s['state']})" for s in live)
            flag("done-live", f"task is {status} but {len(live)} session(s) still running: {names}",
                 f"任务已{'完成' if status == 'done' else '放弃'}，但还有 {len(live)} 个 session 在跑：{names}",
                 sessions=[s["sessionId"] for s in live])
    over = []
    if size > CARD_MAX_BYTES:
        over.append((f"{size // 1000} KB (budget {CARD_MAX_BYTES // 1000} KB)", f"{size // 1000} KB（预算 {CARD_MAX_BYTES // 1000} KB）"))
    if len(refs) > CARD_MAX_REFS:
        over.append((f"{len(refs)} links (budget {CARD_MAX_REFS})", f"{len(refs)} 个链接（预算 {CARD_MAX_REFS}）"))
    if len(meta.get("todos", [])) > CARD_MAX_TODOS:
        n = len(meta["todos"])
        over.append((f"{n} todos (budget {CARD_MAX_TODOS})", f"{n} 条待办（预算 {CARD_MAX_TODOS}）"))
    if over:
        flag("over-budget", "card over budget: " + ", ".join(e for e, _ in over),
             "卡片超预算：" + "，".join(z for _, z in over), bytes=size, refs=len(refs), todos=len(meta.get("todos", [])))
    return {
        "id": meta.get("id"), "title": meta.get("title"), "status": status, "project": meta.get("project") or None,
        "updated": meta.get("updated"), "cardWritten": iso(written), "ageDays": age,
        "next": meta.get("next") or "", "state": [one_line(l, 200) for l in state_lines[:6]],
        "stateMore": max(0, len(state_lines) - 6),
        "log": [{"at": x["at"], "text": one_line(x["text"], 200)} for x in card_log(meta["body"])],
        "todos": todo_groups(meta, seen),
        "asks": {"count": len(asks), "items": [
            {"id": a["id"], "text": one_line(a.get("text"), 200), "since": iso(local_dt(a.get("ts"))),
             "snoozedUntil": a.get("snoozed_until") if snoozed(a) else None} for a in asks[:STATUS_ASKS_SHOWN]]},
        "sessions": shown, "sessionsMore": max(0, n_sessions - len(shown)),
        "flags": flags,
    }


def status_text(s, now):
    """`hq status` as text: one block per task."""
    ago = lambda ts: span((now - local_dt(ts)).total_seconds()) if ts else "?"
    out = [f"{s['id']} {s['title']}  [{s['status']}{' · ' + s['project'] if s['project'] else ''}]"
           f"  updated {s['updated']}, card written {short_time(local_dt(s['cardWritten']), now)}"]
    out += [f"  ⚠ {f['text']}" for f in s["flags"]]
    if s["next"]:
        out.append(f"  next: {one_line(s['next'], 240)}")
    if s["state"]:
        out.append("  state: " + s["state"][0])
        out += [f"         {l}" for l in s["state"][1:]]
        if s["stateMore"]:
            out.append(f"         … +{s['stateMore']} more lines")
    if s["log"]:
        out.append("  log:")
        out += [f"    {x['at'][5:16]}  {x['text']}" for x in s["log"]]
    if s["asks"]["count"]:
        out.append(f"  asks waiting for you ({s['asks']['count']}):")
        out += [f"    {a['id']} [{ago(a['since'])}{', later' if a['snoozedUntil'] else ''}] {a['text']}"
                for a in s["asks"]["items"]]
    for g, label in (("me", "@me"), ("claude", "@claude"), ("others", "others")):
        grp = s["todos"][g]
        if not grp["count"]:
            continue
        shown = f", newest {len(grp['items'])}" if grp["count"] > len(grp["items"]) else ""
        out.append(f"  {label} todos ({grp['count']}{shown}):")
        out += [f"    [{ago(t['since'])}] {'@' + t['owner'] + ' ' if g == 'others' and t['owner'] else ''}{t['text']}"
                for t in grp["items"]]
    if s["sessions"]:
        shown = f", {len(s['sessions'])} shown" if s["sessionsMore"] else ""
        out.append(f"  sessions ({len(s['sessions']) + s['sessionsMore']}{shown}):")
    for x in s["sessions"]:
        bits = [x["state"] + (f" {span(x['idleFor'])}" if x["idleFor"] is not None else ""),
                f"last {short_time(local_dt(x['lastAt']), now)}"]
        if x["context"]:
            c = x["context"]
            bits.append(f"ctx {c['tokens'] // 1000}k/{c['budget'] // 1000}k {c['percent']}%")
        if x["background"]:
            bits.append(f"background: {len(x['background'])} ({x['background'][0]}{', …' if len(x['background']) > 1 else ''})")
        # A session named after its task (the board names them so) says nothing more by name.
        title = re.sub(r"^" + re.escape(s["id"] or "") + r"\s+", "", x["title"] or "")
        title = "" if title == s["title"] else title
        out.append(f"    {x['sessionId'][:8]} {title}".rstrip() + "  ·  " + " · ".join(bits))
        out += [f"      [{m['role']} {short_time(local_dt(m['ts']), now)}] {m['text']}" for m in x["messages"]]
    return "\n".join(out)


def cmd_status(args):
    if args.tasks:
        metas = [parse_card(find_card(t)) for t in dict.fromkeys(args.tasks)]
    else:
        state = load_state()
        live_on = {e.get("task") for sid, e in state.items() if isinstance(e, dict) and e.get("task")
                   and isinstance(pet_session(sid), dict) and pid_alive(pet_session(sid).get("pid"))}
        metas = [parse_card(p) for p in card_paths()]
        if args.focus:
            order = load_focus()
            metas = sorted([m for m in metas if m.get("id") in order and m.get("status") in OPEN_STATUSES],
                           key=lambda m: order.index(m.get("id")))
        else:
            # Every open task, and a finished one only while a session still runs on it.
            metas = [m for m in metas if m.get("status") in OPEN_STATUSES or m.get("id") in live_on]
    now = dt.datetime.now().astimezone()
    state = load_state()
    seen = load_json(os.path.join(HOME_DIR, "state", "todo-seen.json"), {})
    seen = seen if isinstance(seen, dict) else {}
    rows = [task_status(m, state, now, seen) for m in metas]
    if args.flagged:
        rows = [r for r in rows if r["flags"]]
    if args.json:
        print(json.dumps({"now": iso(now), "tasks": rows}, ensure_ascii=False))   # compact: it is read by a model
        return
    if not rows:
        print("no tasks with flags" if args.flagged else "no tasks")
        return
    print("\n\n".join(status_text(r, now) for r in rows))


# ---------------------------------------------------------------- hooks
def last_assistant_text(payload):
    t = payload.get("last_assistant_message")
    if isinstance(t, str) and t.strip():
        return t
    path = payload.get("transcript_path")
    if not path or not os.path.exists(path):
        return ""
    # Read the tail only; transcripts can be large.
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - 400_000))
        tail = f.read().decode("utf-8", "ignore").splitlines()
    for line in reversed(tail):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") == "user" and not o.get("isMeta") and not o.get("isSidechain"):
            c = o.get("message", {}).get("content")
            if isinstance(c, str) or (isinstance(c, list) and any(
                    isinstance(x, dict) and x.get("type") == "text" for x in c)):
                return ""  # reached the user's prompt without finding a reply
        if o.get("type") == "assistant" and not o.get("isSidechain"):
            parts = [x.get("text", "") for x in o.get("message", {}).get("content", [])
                     if isinstance(x, dict) and x.get("type") == "text"]
            if any(p.strip() for p in parts):
                return "\n".join(parts)
    return ""


def update_problems_text(meta, problems):
    return (f"HQ: your hq-update block was NOT applied to {meta['id']} — nothing in it was written:\n"
            + "\n".join(f"- {p}" for p in problems)
            + "\nReply with just the whole hq-update block again, corrected.")


def emit(event, context):
    if context:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": event,
                                                 "additionalContext": context}}, ensure_ascii=False))


def hook_main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if os.environ.get("HQ_HOOK_CHILD"):
        return
    sid = payload.get("session_id", "")
    event = payload.get("hook_event_name", "")
    state = load_state()
    s = state.get(sid)
    if not s:
        return  # unbound sessions cost one small JSON read and nothing else
    try:
        card = find_card(s["task"])
    except SystemExit:
        return
    meta = parse_card(card)

    if event == "SessionStart":
        # Every source — startup, resume, clear, compact — gets the grants in force and the open
        # @claude todos: after a compaction or /clear the session no longer remembers them.
        grants = [g["text"] for g in grants_for(meta)]
        g = grants_change_text(meta, s.get("grants"), s.get("grants_task"), full=True)
        update_session(sid, lambda e: e.update(announced=True, grants=grants, grants_task=meta["id"]))
        parts = [protocol(meta), g, open_asks_text(meta, sid=sid, state=state),
                 claude_todos_text(meta, payload.get("source") or "")]
        emit(event, "\n\n".join(p for p in parts if p))

    elif event == "UserPromptSubmit":
        turn_start = time.time()
        lines = []
        if not s.get("announced", True):
            # Once, in place of the SessionStart this session had before it was bound.
            lines.append("The user bound this session to an HQ task from the board.\n" + protocol(meta))
            todos = claude_todos_text(meta)
            if todos:
                lines.append(todos)
        if s.get("update_problems"):
            lines.append(update_problems_text(meta, s["update_problems"]))
        # An answer goes to the session that asked, once. Another session on the same task
        # doesn't get it — it would act on it too. Only when the asker has left the task (or
        # ended) does the next session on it take the answer over.
        # (`delivered` in sessions.json is the older record; still honoured.)
        legacy = set().union(*(set(e.get("delivered", [])) for e in state.values() if isinstance(e, dict)))
        fresh = [a for a in read_asks(meta["dir"])
                 if a["state"] != "open" and a.get("via") == "board" and not a.get("delivered")
                 and a["id"] not in legacy and not owned_elsewhere(a, sid, meta, state)]
        for a in fresh:
            append_event(meta["dir"], {"type": "delivered", "id": a["id"], "session": sid})
        if fresh:
            lines.append("The user answered these asks on the HQ board since your last turn:")
            for a in fresh:
                lines.append(f"- {a['id']} \"{gist(a['text'])}\" → {answer_text(a['state'], a.get('note'), a.get('granted'))}")
        told = {a["id"] for a in fresh}
        # Grants: the whole list once (SessionStart, or here for a session bound from the board),
        # then only what changed — nothing at all on a turn where nothing did. A grant made by an
        # answer above was just stated with it.
        grants = [g["text"] for g in grants_for(meta)]
        g = grants_change_text(meta, s.get("grants"), s.get("grants_task"),
                               full=not s.get("announced", True), skip=[a.get("granted") for a in fresh])
        if g:
            lines.append(g)

        def note_turn(entry):
            entry.update(turn_start=turn_start, announced=True, grants=grants, grants_task=meta["id"])
            entry.pop("update_problems", None)
            entry["delivered"] = sorted(set(entry.get("delivered", [])) | told)
        update_session(sid, note_turn)
        t = open_asks_text(meta, sid=sid, state=state)
        if t:
            lines.append(t)
        emit(event, "\n".join(lines))

    elif event == "Stop":
        text = last_assistant_text(payload)
        problems = []
        for b in hq_blocks(text):
            if b["kind"] == "hq-update":
                # Only at the end of the reply: one quoted or shown mid-reply is an example.
                if b["trailing"]:
                    problems += apply_update(card, b["body"])
                continue
            kind = b["kind"]
            for line in b["body"].splitlines():
                line = re.sub(r"^\s*(?:[-*]|\d+[.)]|[a-z][.)])\s*", "", line).strip()
                if not line or is_placeholder(line):
                    continue
                if kind == "hq-asks":
                    add_ask(card, line, sid, context=text)
                else:
                    m = re.match(r"(T-\d+\.\d+)\s+(do|drop|later|archive)\b[:\s]*(.*)$", line)
                    if m:
                        try:
                            resolve_ask(m.group(1), m.group(2), m.group(3), via="session")
                        except SystemExit:
                            pass
        if payload.get("stop_hook_active"):
            # One nudge per turn, never a loop. Another Stop hook may have sent the turn back
            # before this one could: tell the session at its next prompt instead of never.
            if problems:
                update_session(sid, lambda e: e.update(update_problems=problems))
            return
        reasons = []
        if problems:
            reasons.append(update_problems_text(meta, problems))
        # Write-back guard: a long turn that never touched the card gets one nudge.
        start = s.get("turn_start")
        if (not problems and start and time.time() - start > WRITEBACK_MIN_TURN_SECONDS
                and os.path.getmtime(card) < start):
            reasons.append(f"HQ: this turn did work on {meta['id']} but the task card was not updated. "
                           "Reply with just an hq-update block (status / next / state / todo / done / log …; "
                           "a block holding only `touch` if nothing changed), then finish.")
        if reasons:
            print(json.dumps({"decision": "block", "reason": "\n\n".join(reasons)}, ensure_ascii=False))


# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(prog="hq", description="task headquarters for Claude Code")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("board", help="print the board"); p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_board)
    p = sub.add_parser("show", help="print a task card and its open asks"); p.add_argument("task")
    p.set_defaults(fn=cmd_show)
    p = sub.add_parser("new", help="create a task card")
    p.add_argument("title"); p.add_argument("--slug"); p.add_argument("--category"); p.add_argument("--project")
    p.add_argument("--no-focus", action="store_true", help="don't add it to Focus")
    p.add_argument("--lead"); p.add_argument("--workdir", action="append"); p.set_defaults(fn=cmd_new)
    p = sub.add_parser("bind", help="bind this Claude session to a task"); p.add_argument("task")
    p.add_argument("--session"); p.set_defaults(fn=cmd_bind)
    p = sub.add_parser("unbind"); p.add_argument("--session"); p.set_defaults(fn=cmd_unbind)
    p = sub.add_parser("whoami", help="task bound to this session"); p.add_argument("--session")
    p.set_defaults(fn=cmd_whoami)
    p = sub.add_parser("touch", help="mark a card as reviewed today"); p.add_argument("task")
    p.set_defaults(fn=cmd_touch)
    p = sub.add_parser("log", help="append a decision/progress line"); p.add_argument("task")
    p.add_argument("message"); p.set_defaults(fn=cmd_log)
    p = sub.add_parser("set", help="set frontmatter fields: hq set T-1 status=done next=...")
    p.add_argument("task"); p.add_argument("fields", nargs="+"); p.set_defaults(fn=cmd_set)
    p = sub.add_parser("todo", help="mark todo #n: hq todo T-1 2 done|drop|open")
    p.add_argument("task"); p.add_argument("index", type=int)
    p.add_argument("state", choices=["done", "drop", "open"]); p.add_argument("--via", default="cli")
    p.add_argument("--text", help="the todo's text as last seen; used if #n no longer matches")
    p.set_defaults(fn=cmd_todo)
    p = sub.add_parser("category", help="hq category list | add NAME | rename OLD NEW | remove NAME [--to OTHER]")
    p.add_argument("action", choices=["list", "add", "rename", "remove"]); p.add_argument("names", nargs="*")
    p.add_argument("--to"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_category)
    p = sub.add_parser("project", help="hq project list | add NAME [--path DIR] | paths NAME DIR... | "
                                         "rename OLD NEW | remove NAME [--to OTHER] | auto | order NAME...")
    p.add_argument("action", choices=["list", "add", "paths", "rename", "remove", "auto", "order"])
    p.add_argument("names", nargs="*"); p.add_argument("--path", action="append"); p.add_argument("--to")
    p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_project)
    p = sub.add_parser("focus", help="the Focus list: hq focus [add|remove|order T-012 ...] [--json]")
    p.add_argument("action", nargs="?", choices=["show", "add", "remove", "order", "carry"], default="show")
    p.add_argument("tasks", nargs="*"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_focus)
    p = sub.add_parser("ref", help="hq ref add|remove T-1 <url or ticket> | restore T-1 <JSON from remove>")
    p.add_argument("action", choices=["add", "remove", "restore"]); p.add_argument("task"); p.add_argument("ref")
    p.set_defaults(fn=cmd_ref)
    p = sub.add_parser("addtodo", help="append a todo: hq addtodo T-1 '@me send the reply'")
    p.add_argument("task"); p.add_argument("text"); p.set_defaults(fn=cmd_addtodo)
    p = sub.add_parser("ask", help="hq ask add <task> <text…> | resolve <ask-id> <res> [note…] | reopen <ask-id>")
    p.add_argument("action", choices=["add", "resolve", "reopen", "delivered", "snooze"]); p.add_argument("target")
    p.add_argument("rest", nargs="*"); p.add_argument("--via", default="cli"); p.add_argument("--note")
    p.add_argument("--session"); p.add_argument("--undo", action="store_true")
    p.add_argument("--until", help="snooze: hide the ask until this local time (default: tomorrow 00:00; \"\" clears)")
    p.add_argument("--grant", help="resolve do: also add this standing grant to the task (\"yes, always\")")
    p.set_defaults(fn=cmd_ask)
    p = sub.add_parser("grant", help="standing grants: hq grant list|add|revoke <task> [wording | n]")
    p.add_argument("action", choices=["list", "add", "revoke"]); p.add_argument("task")
    p.add_argument("rest", nargs="*"); p.add_argument("--source", help="add: the ask it came from")
    p.add_argument("--at", help="add: when it was granted (restoring a revoked one)")
    p.add_argument("--text", help="revoke: the wording as last seen; used if #n no longer matches")
    p.add_argument("--via", default="cli"); p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_grant)
    p = sub.add_parser("asks", help="list open asks"); p.add_argument("task", nargs="?")
    p.add_argument("--all", action="store_true"); p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_asks)
    p = sub.add_parser("scan", help="propose projects and list sessions from existing transcripts (onboarding)")
    p.add_argument("--days", type=int, default=60); p.add_argument("--json", action="store_true")
    p.add_argument("--apply-projects", action="store_true"); p.add_argument("--only")
    p.set_defaults(fn=cmd_scan)
    p = sub.add_parser("sessions", help="live Claude Code sessions (needs Claude Pet)")
    p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_sessions)
    p = sub.add_parser("peek", help="recent messages of a live session"); p.add_argument("session")
    p.add_argument("-n", type=int, default=8); p.add_argument("--json", action="store_true")
    p.add_argument("--meta", action="store_true",
                   help="with --json: an object with title, cwd, live, tool calls, the turn, Claude's todos")
    p.add_argument("--tool", metavar="ID", help="one tool call's full input and output (id from --meta items)")
    p.set_defaults(fn=cmd_peek)
    p = sub.add_parser("jumps", help="how often you jumped to a terminal, by session state and where you clicked")
    p.add_argument("--days", type=int, default=7); p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_jumps)
    p = sub.add_parser("history", help="sessions that worked on a task, newest first (to resume one)")
    p.add_argument("task"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_history)
    p = sub.add_parser("status", help="where tasks stand, with flags where card and sessions disagree "
                                        "(default: every open task)")
    p.add_argument("tasks", nargs="*"); p.add_argument("--focus", action="store_true", help="the Focus list's tasks")
    p.add_argument("--flagged", action="store_true", help="only tasks with a flag")
    p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_status)
    p = sub.add_parser("hook", help="(internal) Claude Code hook entry point")
    p.set_defaults(fn=lambda a: hook_main())

    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help()
        return
    args.fn(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
