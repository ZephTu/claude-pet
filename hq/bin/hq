#!/usr/bin/env python3
"""hq — task headquarters for Claude Code sessions.

One task card (TASK.md) per piece of work, a ledger of things Claude asked you
(asks.jsonl), and hooks that bind sessions to tasks so the card — not the
session — carries the state. See hq/README.md.

Python 3.9+ standard library only (macOS /usr/bin/python3 works). The code is in
../hqlib; this entry imports only what the command needs: a hook runs on every
turn of every session, so it skips the command line and the modules it never uses.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["hook"]:
            try:
                from hqlib.hooks import hook_main
            except ImportError as e:   # hqlib mid-swap by install.sh: hook_main's rule, a line and no traceback
                sys.exit(print(f"hq hook: {type(e).__name__}: {e}", file=sys.stderr))
            hook_main()
        else:
            from hqlib.cli import main
            main()
    except BrokenPipeError:
        pass
